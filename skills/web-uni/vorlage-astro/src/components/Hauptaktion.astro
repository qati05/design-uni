---
// Die Hauptaktion als Link. Text und Ziel aus texte.json; data-zaehl und data-ort sind Zählpunkte (design-uni).
// Form aus der Richtung (design-uni), Text aus text-uni.
import { texte as t } from "../../bau/daten.mjs";
const { ort } = Astro.props;
---
<a href={t.hauptaktion.ziel} data-zaehl="anfrage" data-ort={ort}>{t.hauptaktion.text}</a>
