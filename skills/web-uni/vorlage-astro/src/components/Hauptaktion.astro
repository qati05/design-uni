---
// Der eine Knopf, den die Seite will (Anfrage, Schaden melden, Termin). Text und Ziel stehen in content/betrieb.json.
import b from "../content/betrieb.json";
const { ort, extra = "knopf-gross", text, href } = Astro.props;
---
<a class={`knopf ${extra}`} href={href ?? b.hauptaktion.href} data-zaehl="anfrage" data-ort={ort}>{text ?? b.hauptaktion.text}</a>
