---
// Kopfzeile: Marke, Hauptmenü (mit Aufklappmenü, wenn dienstAnzahl > 0), Hauptaktion, Telefon, Handy-Menü.
import b from "../content/betrieb.json";
import Tel from "./Tel.astro";
const { aktiv = "" } = Astro.props;
const dienst = b.nav.slice(0, b.dienstAnzahl);
const rest = b.nav.slice(b.dienstAnzahl);
const imDienst = dienst.some(([h]) => h === aktiv);
const cur = (h: string) => (aktiv === h ? "page" : undefined);
---
<header class="kopf">
<div class="rahmen kopf-innen">
<a class="marke" href="index.html" aria-label={`${b.name}, zur Startseite`}><span class="marke-text">{b.name}</span></a>
<nav class="nav-desktop" aria-label="Hauptmenü"><ul>{dienst.length > 0 && <li><details class={`dienst${imDienst ? " ist-aktiv" : ""}`}><summary>Dienstleistungen</summary><ul class="dienst-liste">{dienst.map(([h, t]) => <li><a href={h} aria-current={cur(h)}>{t}</a></li>)}</ul></details></li>}{rest.map(([h, t]) => <li><a href={h} aria-current={cur(h)}>{t}</a></li>)}</ul></nav>
<div class="kopf-aktionen">
<a class="knopf knopf-text" href={b.hauptaktion.href} data-zaehl="anfrage" data-ort="kopf">{b.hauptaktion.text}</a>
<Tel ort="kopf" knopf kopf klasse="knopf knopf-leise" />
<details class="menue"><summary>Menü<span class="sr"> öffnen</span></summary>
<nav class="menue-liste" aria-label="Menü"><ul><li><a href="index.html" aria-current={cur("index.html")}>Start</a></li>{b.nav.map(([h, t]) => <li><a href={h} aria-current={cur(h)}>{t}</a></li>)}</ul></nav></details>
</div>
</div>
</header>
