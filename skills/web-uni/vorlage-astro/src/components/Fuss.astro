---
// Gerüst ohne eigenes Aussehen: Name, Anschrift, Telefon, E-Mail, Route, Pflichtseiten.
// Form aus der Richtung (design-uni), Text aus text-uni.
import { betrieb as b, texte as t } from "../../bau/daten.mjs";
import Tel from "./Tel.astro";
import Mail from "./Mail.astro";
import Route from "./Route.astro";
---
<footer>
<address>{b.name}<br>{b.strasse}<br>{b.plz} {b.ort}<br><Tel ort="fuss" /><br><Mail ort="fuss" /></address>
<Route ort="fuss" />
<ul>{t.fuss.map((n: any) => <li><a href={n.pfad}>{n.text}</a></li>)}</ul>
</footer>
