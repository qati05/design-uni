---
// Foto mit Pflichtangaben: alt, breite, hoehe. lazy=false nur für das erste grosse Bild (fetch=true).
const { datei, alt, caption, klasse = "", breite, hoehe, lazy = true, fetch = false } = Astro.props;
---
<figure class={`bild ${klasse}`.trim()}><img src={`bilder/${datei}`} alt={alt} width={breite} height={hoehe} loading={lazy ? "lazy" : undefined} fetchpriority={fetch ? "high" : undefined} decoding="async">{caption && <figcaption>{caption}</figcaption>}</figure>
