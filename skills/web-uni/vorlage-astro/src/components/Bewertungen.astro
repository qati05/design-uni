---
// Bewertungskarten, nur mit Einwilligung der Verfasser und belegten Zahlen. Leere Liste = nichts anzeigen.
import karten from "../content/bewertungen.json";
const stern = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z"/></svg>';
---
{karten.length > 0 && (
<section class="abschnitt" aria-labelledby="bew-titel"><div class="rahmen"><h2 id="bew-titel">Stimmen von Kundinnen und Kunden</h2>
<ul class="karten">{(karten as any[]).map((k) => (
  <li class="karte"><span class="sterne" role="img" aria-label={`${k.sterne} von 5 Sternen`} set:html={stern.repeat(k.sterne)}></span><blockquote><p>{k.text}</p></blockquote><p class="quelle">{k.quelle}, {k.monat}</p></li>
))}</ul></div></section>
)}
