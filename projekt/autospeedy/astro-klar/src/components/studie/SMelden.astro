---
// Studie Startseite (09.11.2026): «Was ist passiert?» als eigenes Band auf Beige.
// Dieselben Schadenarten wie Schritt 1 des Formulars (eine Quelle: arten.json), mit dem Hilfetext von dort.
// Tesla ist keine Schadenart und steht darum als eigene, dunkle Kachel am Schluss.
// Darunter die drei Schritte nach der Meldung, Wortlaut unverändert aus Ablauf.astro (QA K12, K13).
// Ersetzt auf der Startseite: Schnellwahl im Hero, Abschnitt «Ablauf» und das Band «Anfrage».
import { betrieb as b } from "../../../../astro/bau/daten.mjs";
import artenDaten from "../../../../astro/src/content/arten.json";
const arten = (artenDaten as any).arten;
const schritte = [
  { titel: "Wir rufen zurück", text: "In der Regel telefonisch in den Öffnungszeiten. Fehlendes klären wir dann gemeinsam." },
  { titel: "Offerte und Termin", text: "Was die Reparatur kostet, hängt vom Schaden ab. Die Offerte und den Termin besprechen wir persönlich mit Ihnen." },
  { titel: "Wir reparieren", text: "Die Abwicklung mit Ihrer Versicherung übernehmen wir. Einen Ersatzwagen erhalten Sie auf Anfrage." },
];
const pfeil = "M5 12h14M13 6l6 6-6 6";
---
<section class="st-melden" aria-labelledby="melden-titel">
  <div class="st-innen">
    <div class="st-melden__kopf">
      <h2 class="titel" id="melden-titel">Was ist passiert?</h2>
      <p>Tippen Sie an, was passt. Danach brauchen wir nur Ihren Namen und Ihre Telefonnummer, Fotos sind freiwillig.</p>
    </div>
    <ul class="st-arten feder-liste">
      {arten.map((a: any) => (
        <li>
          <a href={`/schaden-melden/?art=${a.id}`}>
            <b>{a.name}</b>
            <span>{a.hilfe}</span>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={pfeil}/></svg>
          </a>
        </li>
      ))}
      <li class="st-arten__tesla">
        <a href="/schaden-melden/?fahrzeug=tesla">
          <b>Tesla?</b>
          <span>Hier entlang</span>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={pfeil}/></svg>
        </a>
      </li>
    </ul>

    <div class="st-danach">
      <h2 class="st-danach__titel" id="ablauf-titel">Nach Ihrer Meldung geht es so weiter.</h2>
      <ol class="st-danach__liste feder-liste">
        {schritte.map((s, i) => (
          <li>
            <span class="zahl" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="st-melden__tel">Lieber sprechen? <a href={`tel:${b.tel.e164}`}>Anrufen <span class="nr">{b.tel.anzeige}</span></a></p>
    </div>
  </div>
</section>
