---
// Studie Startseite (09.11.2026): Hero.
// Gleicher Wortlaut wie Hero.astro (Slogan und Einleitung des Betriebs, unverändert). Anders ist nur der Aufbau:
// - Am Handy steht das Foto zuerst, danach Slogan, Einleitung und beide Knöpfe in einer Zeile.
// - Die Schadenarten sind aus dem Hero in ein eigenes Band gewandert (SMelden.astro).
// - Ort, Öffnungszeiten und Ersatzwagen stehen als ruhige Zeile unten im Hero statt als eigene Leiste.
// Die Klassen «hero» und «ctas» bleiben, weil klar.js daran die Handyleiste steuert (erst nach den Hero-Knöpfen).
import { betrieb as b } from "../../../../astro/bau/daten.mjs";
import Bild from "../Bild.astro";
import { zeitenOffen as offen } from "../../daten/zeiten";
---
<section class="hero st-hero">
  <figure class="st-hero__bild">
    <Bild name="defender-kabine" alt="Land Rover Defender in der hell beleuchteten Kabine der Werkstatt" sizes="(max-width: 760px) 100vw, 46vw" lcp />
  </figure>
  <div class="st-hero__text">
    <div class="st-hero__mitte">
      <h1><span>Qualität,</span><br><em>die man sieht und fährt.</em></h1>
      <p class="lead">Carrosserie und Lack in Altstätten, für alle Marken und als Tesla Approved Body Shop. Die Abwicklung mit Ihrer Versicherung übernehmen wir. Einen Ersatzwagen erhalten Sie auf Anfrage.</p>
      <div class="ctas st-hero__ctas">
        <a class="knopf knopf--akzent" href="/schaden-melden/">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15.5 5.6 10a2 2 0 0 1 1.9-1.5h9a2 2 0 0 1 1.9 1.5l1.6 5.5"/><path d="M3.5 15.5h17v3h-17z"/><path d="M7 18.5v1.5M17 18.5v1.5"/><path d="m12 2.8.9 2.3 2.1-.7-.9 2"/></svg>Schaden melden</a>
        <a class="knopf knopf--kontur" href={`tel:${b.tel.e164}`} aria-label={`Anrufen: ${b.tel.anzeige}`}>
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6.6 3.5h2.6l1.4 4-1.9 1.3a12 12 0 0 0 6.5 6.5l1.3-1.9 4 1.4v2.6A2.1 2.1 0 0 1 18.4 19.5 15 15 0 0 1 4.5 5.6 2.1 2.1 0 0 1 6.6 3.5Z"/></svg><span>Anrufen <span class="nr">{b.tel.anzeige}</span></span></a>
      </div>
      <p class="hero-status" data-hero-status hidden><span data-status></span><span class="hero-status__zu" data-wenn-zu hidden> Online melden geht jederzeit, wir rufen Sie zurück.</span></p>
    </div>
    <dl class="st-fakten">
      <div>
        <dt>Ort</dt>
        <dd>{b.strasse}<br>{b.plz} {b.ort} {b.kanton}</dd>
      </div>
      <div>
        <dt>Öffnungszeiten</dt>
        <dd>{offen.map((zeile: string, i: number) => <>{i > 0 && <br />}{zeile}</>)}</dd>
      </div>
      <div>
        <dt>Ersatzwagen</dt>
        <dd><span class="zahl">{b.ersatzwagen.anzahl}</span> Ersatzautos auf Anfrage{b.ersatzwagen.tesla ? ", auch ein Tesla" : ""}</dd>
      </div>
    </dl>
  </div>
</section>
