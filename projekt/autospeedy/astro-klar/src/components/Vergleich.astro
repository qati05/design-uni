---
// Vorher-nachher-Regler (BAUPLAN 2 Zeile 6, 3.8). input type=range + --pos (@property) + aria-valuetext;
// Logik in /js/klar.js (data-vergleich): Maus folgt ohne Klick (120 ms), Touch 1:1 ohne Transition,
// Tippen und Tastatur springen (--feder-regler). Linie und Griff ueber transform: translateX mit der
// Container-Query-Einheit cqi (kein Layout-Lesen pro Frame). Ohne JavaScript steht die Linie in der Mitte.
// caption: C-Rahmenstil mit einer Bildunterschrift. Ohne caption die bestehende Hilfe (Unterseiten).
// ohneHilfe: nur der Titel als Unterschrift, wenn die Seite schon sagt, wie man den Regler bedient.
import Bild from "./Bild.astro";
import Luecke from "./Luecke.astro";
import { notizen } from "../../../astro/bau/daten.mjs";
// luecke: Vermerk, den der Betrieb noch auflösen muss (z. B. Beispielbilder). Steht mit Notizen als sichtbarer Kasten
// unter dem Regler (sonst die normale Bildunterschrift) und sperrt den Live-Bau, bis er geschlossen oder freigegeben ist.
const { vorher, nachher, altVorher, altNachher, titel, caption = null, luecke = null, platzhalter = false, platzVorher = null, platzNachher = null, ohneHilfe = false, sizes = "(max-width: 960px) 100vw, 60vw" } = Astro.props;
---
<figure class="vergleich" data-vergleich>
  <div class="vergleich__buehne">
    <Bild name={nachher} platz={platzNachher} vorsatz="Nachher: " alt={altNachher} sizes={sizes} klasse="vergleich__nachher" />
    <div class="vergleich__vorher"><Bild name={vorher} platz={platzVorher} vorsatz="Vorher: " alt={altVorher} sizes={sizes} /></div>
    <span class="vergleich__linie" aria-hidden="true"><span class="vergleich__griff"></span></span>
    <span class="vergleich__marke vergleich__marke--vorher" aria-hidden="true">Vorher</span>
    <span class="vergleich__marke vergleich__marke--nachher" aria-hidden="true">Nachher</span>
    {notizen && platzhalter && !caption && <span class="vergleich__platzhalter">Platzhalter-Fotos</span>}
    <input class="vergleich__regler" type="range" min="0" max="100" step="1" value="50" aria-label={`${titel}: Anteil «vorher» im Bild`} aria-valuetext="50 Prozent vorher">
  </div>
  {luecke && <Luecke>{luecke}</Luecke>}
  {luecke && notizen
    ? null
    : caption
    ? <figcaption class="vergleich__text">{caption}</figcaption>
    : <figcaption class="vergleich__text"><b>{titel}</b>{!ohneHilfe && <span class="vergleich__hilfe"><span class="nur-maus">Maus über das Bild bewegen</span><span class="nur-touch">Waagrecht wischen</span></span>}</figcaption>}
</figure>
