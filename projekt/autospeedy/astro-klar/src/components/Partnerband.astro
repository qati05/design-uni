---
// Partner als ruhige Reihe: vier Logos in Graustufen brauchen kein Laufband (Critique 04.11.2026, ersetzt BAUPLAN 3.9).
// Logos sind vom Betrieb freigegeben (Reshat 04.11.). Land Rover ohne Logo als Wortmarke im gleichen Grau.
// Tesla-Logo optisch gleich schwer gemacht (kleinere Kappenhöhe, .partnerband__karte--tesla in klar.css).
const PARTNER = [
  { name: "Tesla Approved Body Shop", datei: "tesla-approved-body-shop.webp", b: 300, h: 84, link: "/tesla/", karte: "partner__karte--tesla" },
  { name: "AMAG", datei: "amag.webp", b: 300, h: 102 },
  { name: "Land Rover", wortmarke: true },
  { name: "Ayvens", datei: "ayvens.webp", b: 300, h: 61 },
];
const { titel = "Zertifizierte Partner" } = Astro.props;
---
<section class="partner" aria-labelledby="partner-label">
  <h2 class="partner__label" id="partner-label">{titel}</h2>
  <ul class="partner__reihe">
    {PARTNER.map((p: any) => {
      const inhalt = p.wortmarke
        ? <span class="partner__wortmarke">{p.name}</span>
        : <img src={`/bilder/partner/${p.datei}`} alt={p.name} width={p.b} height={p.h} decoding="async" loading="lazy" />;
      return <li class={`partner__karte${p.karte ? " " + p.karte : ""}`}>{p.link ? <a href={p.link}>{inhalt}</a> : inhalt}</li>;
    })}
  </ul>
</section>
