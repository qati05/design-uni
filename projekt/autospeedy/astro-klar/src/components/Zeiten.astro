---
// Öffnungszeiten als Tabelle, nur aus betrieb.json (wie die erste Linie).
import { betrieb as b, texte as t, bau } from "../../../astro/bau/daten.mjs";
// ausnahmen=false zeigt nur die regulaeren Zeiten (der Schluss-Abschnitt listet die Ferien/Feiertage separat).
const { ausnahmen = true } = Astro.props;
import { zeitZeile as zeile } from "../daten/zeiten"; // eine Schreibweise auf der ganzen Linie (QA K19)
const datum = new Intl.DateTimeFormat(bau.sprache, { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const heute = new Date().toISOString().slice(0, 10);
---
<table class="zeiten"><tbody>
{b.zeiten.map((z: any) => <tr><th scope="row">{z.tage}</th><td>{zeile(z)}</td></tr>)}
{ausnahmen && (b.ausnahmen || []).filter((a: any) => (a.ende || a.datum) >= heute).map((a: any) => <tr><th scope="row">{a.name}, <time datetime={a.datum}>{datum.format(new Date(a.datum + "T00:00:00Z"))}</time>{a.ende && <> bis <time datetime={a.ende}>{datum.format(new Date(a.ende + "T00:00:00Z"))}</time></>}</th><td>{zeile(a)}</td></tr>)}
</tbody></table>
