---
// Tesla-Abschnitt Entwurf C (BAUPLAN 2 Zeile 8, 3.5, 3.7). Struktur und Texte woertlich aus
// referenz-c/entwurf-c.html (.tesla, .tesla-kopf, .spec, .tesla-bild, .ablauf, .tesla-ende):
// 5fr Kopf mit Faktentabelle (.spec) | 7fr Fotoband 21:9 und Ablauf (Punkte auf einer Linie, ohne Ziffern seit QA K12; bleibt als Entwurf markiert).
// Fotoband B7 als WebP 640/1280/1920 aus public/bilder/stock/ (erzeugt von bau/stock-c.mjs).
// Platzhalter von Unsplash (Philipp Mandler), Credit unter /bildnachweise/.
const band = "/bilder/stock/b7-tesla";
---
<section id="tesla" class="tesla-teil" aria-labelledby="tesla-titel">
  <div class="tesla-kopf">
    <h2 id="tesla-titel" class="titel">Tesla Approved Body Shop.</h2>
    <p>Wir reparieren Ihren Tesla als zugelassener Carrosserie-Partner, nach den Reparaturvorgaben von Tesla und mit Original-Ersatzteilen.</p>
    <dl class="spec">
      <div><dt>Teile</dt><dd>Original-Ersatzteile</dd></div>
      <div><dt>Versicherung</dt><dd>Abwicklung durch uns</dd></div>
      <div><dt>Lack</dt><dd>Neue, grössere Lackierkabinen</dd></div>
      <div><dt>Ersatzwagen</dt><dd>Tesla auf Anfrage</dd></div>
    </dl>
  </div>
  <div class="tesla-rechts">
    <figure class="tesla-bild foto-ein">
      <img
        src={`${band}-1280.webp`}
        srcset={`${band}-640.webp 640w, ${band}-1280.webp 1280w, ${band}-1920.webp 1920w`}
        sizes="(max-width: 960px) 100vw, 58vw"
        width="1280" height="549"
        loading="lazy" decoding="async"
        alt="Scheinwerfer eines schwarzen Tesla Model S">
      <figcaption>Platzhalter von Unsplash (Philipp Mandler), wird durch ein eigenes Foto ersetzt.</figcaption>
    </figure>
    <ol class="ablauf">
      {/* QA K12: ohne Ziffern 01/02/03, damit keine zweite Schrittzählung neben «in zwei Schritten» (Formular) steht. */}
      <li><b>Melden</b><span>Online oder per Telefon.</span></li>
      <li><b>Begutachten</b><span>Prüfung am Fahrzeug, Original-Teile bestellen, Versicherung klären.</span></li>
      <li><b>Reparieren</b><span>Instandsetzung nach Tesla-Vorgaben, Übergabe mit Erklärung.</span></li>
    </ol>
    <div class="tesla-ende">
      <p class="hinweis">Entwurf: Ablauf vom Betrieb zu bestätigen.</p>
      <a class="knopf knopf--akzent" href="/schaden-melden/?tesla=1">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15.5 5.6 10a2 2 0 0 1 1.9-1.5h9a2 2 0 0 1 1.9 1.5l1.6 5.5"/><path d="M3.5 15.5h17v3h-17z"/><path d="M7 18.5v1.5M17 18.5v1.5"/><path d="m12 2.8.9 2.3 2.1-.7-.9 2"/></svg>Tesla-Schaden melden</a>
    </div>
  </div>
</section>
