---
// Rückruf in einem Schritt (gleiche Logik wie die erste Linie: /js/rueckruf.js → POST /api/rueckruf, direkt per Mail an
// den Betrieb, kein Cockpit; Entscheid Roni 08./09.11.2026). Endpunkt auf derselben Herkunft wie /api/schaden.
import { betrieb as b, bau, vorschau } from "../../../astro/bau/daten.mjs";
const { anliegen = ["Allgemein"], titel = "Wir rufen Sie zurück", text, ort = "rueckruf", hilfe = "Zum Beispiel: Delle an der Tür, Kratzer am Stossfänger. Kosten und Termin besprechen wir am Telefon, sie hängen vom Schaden ab." } = Astro.props;
const formular = process.env.FORMULAR_ENDPUNKT || bau.formularEndpunkt || "";
const endpunkt = !formular ? "" : /\/api\/schaden\/?$/.test(formular) ? formular.replace(/\/api\/schaden\/?$/, "/api/rueckruf") : "/api/rueckruf";
const id = `rr-${ort}`;
const turnstile = process.env.TURNSTILE_SITEKEY || "";
// Zeitwahl zum Antippen (Roni 07.11.): Wochentage × Vormittag/Nachmittag aus den Öffnungszeiten, freiwillig, mehrere möglich.
const tage = [["Mo", "Montag"], ["Di", "Dienstag"], ["Mi", "Mittwoch"], ["Do", "Donnerstag"], ["Fr", "Freitag"]];
const fenster = (b.zeiten.find((z: any) => z.fenster && z.fenster.length === 2) || { fenster: [["7.30", "12.00"], ["13.15", "17.30"]] }).fenster;
// QA K19: Zeiten in derselben Schreibweise wie im Fuss («7.30 bis 12.00 Uhr»).
import { fensterText } from "../daten/zeiten";
const teile = [["Vormittag", fensterText(fenster[0][0], fenster[0][1])], ["Nachmittag", fensterText(fenster[1][0], fenster[1][1])]];
---
<form class="karte rueckruf" data-rueckruf action={`mailto:${b.mail}?subject=R%C3%BCckruf`} method="post" enctype="text/plain" data-endpunkt={endpunkt} data-ist-vorschau={vorschau ? "ja" : "nein"} data-zaehl-start={`rueckruf-${ort}`}>
  <h2 class="karte__titel">{titel}</h2>
  {text && <p class="karte__text">{text}</p>}
  {anliegen.length > 1 ? (
    <fieldset class="chips"><legend>Worum geht es? (Pflicht)</legend><div class="chips__wahl">{anliegen.map((a: string, i: number) => <label><input type="radio" name="anliegen" value={a} required checked={i === 0}> <span>{a}</span></label>)}</div></fieldset>
  ) : <input type="hidden" name="anliegen" value={anliegen[0]} />}
  <div class="felder felder--zwei">
    <div class="feld"><label for={`${id}-name`}>Name (Pflicht)</label><input id={`${id}-name`} name="name" type="text" autocomplete="name" required></div>
    <div class="feld"><label for={`${id}-tel`}>Telefon (Pflicht)</label><input id={`${id}-tel`} name="telefon" type="tel" autocomplete="tel" required></div>
  </div>
  <div class="feld"><label for={`${id}-text`}>Ihre Nachricht (freiwillig)</label><textarea id={`${id}-text`} name="bemerkung" rows="2" maxlength="1000"></textarea><p class="hilfe">{hilfe}</p></div>
  <fieldset class="zeitwahl">
    <legend>Wann passt ein Anruf? (freiwillig)</legend>
    <p class="hilfe">Tippen Sie an, was passt, gern mehrere Felder. Leer gelassen rufen wir in den Öffnungszeiten an.</p>
    <div class="zeitwahl__raster">
      <span aria-hidden="true"></span>
      {tage.map(([k]) => <span class="zeitwahl__tag" aria-hidden="true">{k}</span>)}
      {teile.map(([teil, zeit]) => <>
        <span class="zeitwahl__teil" aria-hidden="true">{teil}<small>{zeit}</small></span>
        {tage.map(([, tag]) => <label class="zeitwahl__feld"><input type="checkbox" name="zeit" value={`${tag} ${teil}`}><span class="zeitwahl__marke" aria-hidden="true"></span><span class="nur-vorlesen">{tag} {teil}</span></label>)}
      </>)}
    </div>
  </fieldset>
  <div class="honig" aria-hidden="true"><label for={`${id}-web`}>Bitte leer lassen (freiwillig)</label><input id={`${id}-web`} name="website" type="text" tabindex="-1" autocomplete="off"></div>
  <button class="k k--blau" type="submit" data-zaehl={`rueckruf-${ort}`} data-ort={ort}>Rückruf anfordern</button>
  {turnstile && <div class="cf-turnstile" data-sitekey={turnstile} data-language="de"></div>}
  <p class="hilfe">Verantwortlich: {b.name}. Wir nutzen Name und Telefon nur für den Rückruf. Mehr in der <a class="textlink" href="/datenschutz/">Datenschutzerklärung</a>.</p>
  {turnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <p class="rueckmeldung" data-rueckmeldung hidden role="status"></p>
</form>
