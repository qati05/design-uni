---
// Hinweis-Vorlagen (BAUPLAN 4.2): feste Designs im Stil C. Je Art eine Farbe und ein Symbol; der Betrieb schreibt nur
// Titel, Text und Zeitraum. Banner über dem Kopf (schliessbar, Merker in sessionStorage), Pop-up als <dialog> nach 2 s.
// Der Build zeigt nur Hinweise mit von ≤ heute ≤ bis (Europe/Zurich); data-von/data-bis erlauben klar.js, im Browser
// zusätzlich ausserhalb des Zeitraums auszublenden, falls der nächtliche Neubau einmal ausfällt.
// Der Text wird von Astro escaped; das Linkziel kommt ausschliesslich aus der Whitelist HINWEIS_LINKS.
import { pflege } from "../../../astro/bau/daten.mjs";
import { HINWEIS_LINKS, heuteZuerich, sichtbareHinweise } from "../../../gemeinsam/site.ts";

const erlaubt = new Set(HINWEIS_LINKS.map((l) => l.wert));
const linkText = new Map(HINWEIS_LINKS.map((l) => [l.wert, l.text]));
const heute = heuteZuerich();
const sichtbar = sichtbareHinweise(pflege?.hinweise, heute);

// Pop-up nie auf /schaden-melden/ (4.2). Höchstens ein Pop-up (das Schema garantiert das bereits).
const pfad = Astro.url.pathname;
const aufSchaden = pfad.startsWith("/schaden-melden");
const banner = sichtbar.filter((h) => h.form === "banner");
const popup = aufSchaden ? null : sichtbar.find((h) => h.form === "popup") || null;

// Symbol je Art (BAUPLAN 4.2). Reines SVG, aria-hidden; keine erfundenen Inhalte.
const SYMBOL: Record<string, string> = {
  hagel: '<path d="M12 2.5c3.2 3.4 5.2 6.1 5.2 8.8a5.2 5.2 0 1 1-10.4 0C6.8 8.6 8.8 5.9 12 2.5Z"/><circle cx="12" cy="19.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="8" cy="21" r="1.1" fill="currentColor" stroke="none"/><circle cx="16" cy="21" r="1.1" fill="currentColor" stroke="none"/>',
  ferien: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 9.5h17M8 3.5v3M16 3.5v3"/>',
  geschlossen: '<rect x="5" y="10.5" width="14" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>',
  aktion: '<path d="M12 3.2 14.5 8.6l5.9.7-4.4 4 1.2 5.8L12 16.3 6.8 19.1 8 13.3l-4.4-4 5.9-.7Z"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.8h.01"/>',
};

function ziel(h: { link: string }): string | null {
  return h.link && erlaubt.has(h.link) ? h.link : null;
}
---
{banner.length > 0 && (
  <div class="hinweise" data-hinweise>
    {banner.map((h) => {
      const z = ziel(h);
      return (
        <p class={`hinweis hinweis--${h.art}`} data-hinweis data-key={`${h.art}|${h.von}|${h.bis}`} data-von={h.von} data-bis={h.bis}>
          <svg class="hinweis__symbol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={SYMBOL[h.art]} />
          <span class="hinweis__text">
            {h.titel && <b>{h.titel}</b>}
            {h.titel && h.text && " "}
            {h.text}
            {z && <a class="hinweis__link" href={z}>{linkText.get(z)} <span aria-hidden="true">→</span></a>}
          </span>
          <button type="button" class="hinweis__zu" data-hinweis-zu aria-label="Hinweis schliessen">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
          </button>
        </p>
      );
    })}
  </div>
)}
{popup && (() => {
  const z = ziel(popup);
  return (
    <dialog class={`hinweis-popup hinweis--${popup.art}`} data-hinweis-popup data-von={popup.von} data-bis={popup.bis} aria-labelledby="hinweis-popup-titel">
      <div class="hinweis-popup__kopf">
        <svg class="hinweis__symbol" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={SYMBOL[popup.art]} />
        <button type="button" class="hinweis__zu" data-hinweis-popup-zu aria-label="Schliessen">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
      </div>
      {popup.titel && <h2 id="hinweis-popup-titel" class="hinweis-popup__titel">{popup.titel}</h2>}
      <p class="hinweis-popup__text">{popup.text}</p>
      {z && <a class="knopf knopf--akzent" href={z}>{linkText.get(z)}</a>}
    </dialog>
  );
})()}
