---
// «So geht es weiter» (Kundenweg, KUNDENWEG.md 2): nimmt die Frage vorweg, die nach einem frischen Schaden vom
// Melden abhält: «Was passiert, wenn ich melde?». Drei Schritte, nur Belegtes aus dem Formular und der Startseite
// (Pflicht nur Art, Name, Telefon; Rückruf in der Regel in den Öffnungszeiten; Versicherung übernehmen wir;
// Ersatzwagen auf Anfrage). Keine Fristen, keine Dauer, keine Zusagen.
// Steht direkt vor dem Aufruf (Anfrage), der die Knöpfe trägt; darum hier kein eigener Knopf.
// Bewegung: Schritte sinken einzeln ein (Feder, .feder-liste in klar.js/klar.css), nie unter «Bewegung reduzieren».
const schritte = [
  { titel: "Sie melden", text: "Was passiert ist, Ihr Name und Ihre Telefonnummer. Fotos und alles Weitere sind freiwillig." },
  { titel: "Wir rufen zurück", text: "In der Regel telefonisch in den Öffnungszeiten. Fehlendes klären wir dann gemeinsam." },
  { titel: "Wir reparieren", text: "Die Abwicklung mit Ihrer Versicherung übernehmen wir. Einen Ersatzwagen erhalten Sie auf Anfrage." },
];
---
<section class="ablauf-kunde" aria-labelledby="ablauf-titel">
  <div class="ablauf-kunde__kopf feder">
    <h2 class="titel" id="ablauf-titel">So geht es nach dem Melden weiter.</h2>
  </div>
  <ol class="ablauf-kunde__liste feder-liste">
    {schritte.map((s, i) => (
      <li>
        <span class="ablauf-kunde__nr zahl" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        <h3>{s.titel}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>
</section>
