---
// Leistungen Entwurf C (Nachtrag 04.11.2026): 6 Karten in fester Reihenfolge, jede mit Bild im Format 3:2
// (Desktop Bild oben, Handy 88-px-Quadrat links). Jede Karte ist ganz klickbar (genau ein Link) und zeigt
// auf die eigene Seite der Leistung. Darunter die
// Zeile «Ausserdem: Occasionen und Ankauf.». Der Aufruf folgt direkt danach im Band (Anfrage). Kein Felgen-Vorher/Nachher auf der Startseite.
// Bilder sind Stock-Platzhalter aus public/bilder/leistungen/ (erzeugt von bau/bilder-c.mjs), spaeter durch das
// Shooting ersetzbar (S03-S08, gleiche Dateinamen). Bildnachweise sind nicht noetig (betriebseigene Quelle).
// Felgen heisst nur «Felgen», nie «Alufelgen» (Reshat 04.11.).
import { leistungen } from "../daten/leistungen";
import { site } from "../../../astro/bau/daten.mjs";
const karten = leistungen;
const { uebersicht = false } = Astro.props;
---
<section class={uebersicht ? "leistungen leistungen--uebersicht" : "leistungen"} id="leistungen" aria-labelledby="leistungen-titel">
  <h2 class="titel" id="leistungen-titel">Was wir für Sie machen.</h2>
  <ul class="karten karten--bild">
    {karten.map((k) => (
      <li>
        <a href={k.pfad}>
          <span class="leist-bild">
            <picture>
              <source type="image/avif" srcset={`/bilder/leistungen/${k.slug}-400.avif 400w, /bilder/leistungen/${k.slug}-800.avif 800w`} sizes="(max-width: 720px) 88px, (max-width: 960px) 46vw, 30vw" />
              <source type="image/webp" srcset={`/bilder/leistungen/${k.slug}-400.webp 400w, /bilder/leistungen/${k.slug}-800.webp 800w`} sizes="(max-width: 720px) 88px, (max-width: 960px) 46vw, 30vw" />
              {(site.bilder as any)?.[`leistung-${k.slug}`]
                ? <img src={(site.bilder as any)[`leistung-${k.slug}`].foto} width={(site.bilder as any)[`leistung-${k.slug}`].b} height={(site.bilder as any)[`leistung-${k.slug}`].h} loading="lazy" decoding="async" alt={(site.bilder as any)[`leistung-${k.slug}`].alt} />
                : <img src={`/bilder/leistungen/${k.slug}-800.webp`} width="800" height="533" loading="lazy" decoding="async" alt={k.altKarte} />}
            </picture>
          </span>
          <h3>{k.titel}</h3>
          <p>{k.kurz}</p>
          <span class="pfeil"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </a>
      </li>
    ))}
  </ul>
  <p class="ausserdem">Ausserdem: Occasionen und Ankauf. <a href="/occasionen/">Occasionen ansehen</a>.</p>
</section>
