---
// Abschnitt «Inhaber und Team» auf der Startseite.
// Design-Review 07.11.2026 (Roni): keine B8-Platzhalter mehr. Statt der leeren Kästen zeigt der Abschnitt echte
// Teamporträts aus site.json (Erlaubnis Roni, 04.11.2026; nur Personen mit einverstaendnis und Foto).
// Das Inhaber-Zitat erscheint erst mit site.stimme.freigegeben, mit dem Porträt der ersten Person (Geschäftsführer).
// Ohne freigegebenes Zitat wird nichts erfunden und kein Platzhaltertext gezeigt.
import { site } from "../../../astro/bau/daten.mjs";
const stimme = (site as any).stimme;
const freigegeben = !!(stimme && stimme.freigegeben);
const leute = (site as any).team
  .flatMap((g: any) => g.leute)
  .filter((p: any) => p.einverstaendnis && p.foto);
const chef = leute[0];
const reihe = leute.slice(freigegeben ? 1 : 0, (freigegeben ? 1 : 0) + 4);
const kurz = (n: string) => n.replace(/ «.*»/, "");
---
<section id="team" class="abschnitt inhaber-teil" aria-labelledby="team-titel">
  <div class="abschnitt__innen">
    <h2 class="titel" id="team-titel">Zehn Leute, eine Werkstatt.</h2>
    {freigegeben && chef && (
      <div class="inhaber">
        <img class="inhaber__bild" src={chef.foto} width="640" height="800" loading="lazy" decoding="async" alt={`Porträt ${kurz(chef.name)}`}>
        <blockquote><p>{stimme.text}</p><footer>{[stimme.name, stimme.rolle].filter(Boolean).join(", ")}</footer></blockquote>
      </div>
    )}
    <div class="leute leute--start">
      {reihe.map((p: any) => (
        <figure>
          <img src={p.foto} width="640" height="800" loading="lazy" decoding="async" alt={`Porträt ${kurz(p.name)}`}>
          <figcaption><b>{p.name}</b><span>{p.rolle}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="team-zeile">An der Alten Landstrasse in Altstätten, von der Annahme bis zum Finish.</p>
    <div class="mehr"><a class="k k--rand" href="/team/">Ganzes Team</a></div>
  </div>
</section>
