---
// Rahmen der Linie «Klar». Titel und Beschreibung aus texte.json wie in der ersten Linie (dieselbe Quelle, dieselben Prüfungen).
import { texte, vorschau, seite as lies } from "../../../astro/bau/daten.mjs";
import Kopf from "../components/Kopf.astro";
import Fuss from "../components/Fuss.astro";
const { seite } = Astro.props;
const s = lies(seite);
---
<!doctype html>
<html lang="de-CH" data-zaehl-endpunkt={process.env.ZAEHL_ENDPUNKT || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{s.titel}</title>
{s.beschreibung && <meta name="description" content={s.beschreibung}>}
{vorschau && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#ffffff">
<link rel="preload" href="/fonts/hanken-grotesk-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/klar.css">
<script is:inline>document.documentElement.classList.add("js")</script>
<script is:inline src="/js/klar.js" defer></script>
<script is:inline src="/js/zaehl.js" defer></script>
</head>
<body>
<a class="sprung" href="#inhalt">{texte.mikrotexte.sprunglink}</a>
{vorschau && <p data-vorschau>{texte.mikrotexte.vorschauHinweis}</p>}
<Kopf aktiv={Astro.url.pathname} />
<main id="inhalt">
<slot />
</main>
<Fuss />
</body>
</html>
