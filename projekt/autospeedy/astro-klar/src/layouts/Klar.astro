---
// Rahmen der Linie «Klar». Titel und Beschreibung aus texte.json wie in der ersten Linie (dieselbe Quelle, dieselben Prüfungen).
// Nachtrag 04.11.2026: SEO (Titel, Beschreibung, Canonical, Open Graph, Twitter, Icons) und AEO (JSON-LD AutoBodyShop
// mit Services, areaServed, sameAs; aggregateRating NUR live; FAQPage und BreadcrumbList je Seite als Props).
import { texte, vorschau, seite as lies } from "../../../astro/bau/daten.mjs";
import bewDaten from "../daten/bewertungen.json";
import { leistungen } from "../daten/leistungen";
import Kopf from "../components/Kopf.astro";
import Fuss from "../components/Fuss.astro";
import Hinweis from "../components/Hinweis.astro";
const { seite, titel, beschreibung, jsonld = false, bildVorladen = null, ogBild = "/bilder/stock/og-start.jpg", brotkrumen = null, faq = null, dienst = null, ldExtra = [] } = Astro.props;
import { betrieb as b, bau } from "../../../astro/bau/daten.mjs";
const pad = (z: string) => z.replace(".", ":").padStart(5, "0");
const s = { ...lies(seite), ...(titel ? { titel } : {}), ...(beschreibung ? { beschreibung } : {}) };

// Basis-URL: im Livegang aus bau.adresse, in der Vorschau die bekannte Betriebsdomain als Platzhalter (noindex bleibt).
const basis = (bau.adresse || "https://www.autospeedy.ch").replace(/\/$/, "");
const canonical = basis + Astro.url.pathname;
const istFehlerseite = seite === "404"; // 404: kein canonical, kein JSON-LD (nicht indexierbar)
const ogAbs = /^https?:/.test(ogBild) ? ogBild : basis + ogBild;

// Öffnungszeiten für JSON-LD.
const zeiten = b.zeiten.filter((z: any) => z.fenster).flatMap((z: any) => z.fenster.map(([von, bis]: string[]) => ({ "@type": "OpeningHoursSpecification", dayOfWeek: z.ld.length === 1 ? z.ld[0] : z.ld, opens: pad(von), closes: pad(bis) })));

// aggregateRating NUR mit echten Daten und NUR live (nie in der Vorschau). Quelle: dieselbe bewertungen.json wie Bewertungen.astro.
let rating: any = null;
const bd = bewDaten as any;
if (!vorschau && bd && bd.status === "ok" && typeof bd.note === "number" && typeof bd.anzahl === "number")
  rating = { "@type": "AggregateRating", ratingValue: bd.note, reviewCount: bd.anzahl, bestRating: 5 };

const betriebLd: any = {
  "@type": b.typ, "@id": basis + "/#betrieb", name: b.name, url: basis + "/", image: ogAbs, telephone: b.tel.e164, email: b.mail,
  address: { "@type": "PostalAddress", streetAddress: b.strasse, postalCode: b.plz, addressLocality: b.ort, addressRegion: b.kanton, addressCountry: b.land },
  logo: basis + "/bilder/logo-144.png", hasMap: b.route,
  areaServed: [{ "@type": "City", name: "Altstätten" }, { "@type": "AdministrativeArea", name: "Rheintal" }],
  openingHoursSpecification: zeiten,
  makesOffer: leistungen.map((l) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: l.titel, description: l.kurz, url: basis + l.pfad } })),
};
if (b.geo && b.geo.lat && b.geo.lon) betriebLd.geo = { "@type": "GeoCoordinates", latitude: b.geo.lat, longitude: b.geo.lon };
const sameAs = [b.bewertungen && b.bewertungen.facebook, b.occasionen && b.occasionen.liste].filter(Boolean);
if (sameAs.length) betriebLd.sameAs = sameAs;
if (rating) betriebLd.aggregateRating = rating;

// Nachtrag 08.11.2026 (SEO/AEO): WebSite und WebPage je Seite, damit Suchmaschinen und KI-Assistenten Seite, Betrieb und
// Brotkrumen verknüpfen; Service-Knoten auf Leistungsseiten (Prop `dienst`), weitere Knoten über `ldExtra` (Team, Occasionen).
const area = betriebLd.areaServed;
const graph: any[] = [
  betriebLd,
  { "@type": "WebSite", "@id": basis + "/#website", url: basis + "/", name: b.name, inLanguage: "de-CH", publisher: { "@id": basis + "/#betrieb" } },
  { "@type": "WebPage", "@id": canonical + "#seite", url: canonical, name: s.titel, ...(s.beschreibung ? { description: s.beschreibung } : {}), inLanguage: "de-CH",
    isPartOf: { "@id": basis + "/#website" }, about: { "@id": basis + "/#betrieb" }, ...(brotkrumen ? { breadcrumb: { "@id": canonical + "#brotkrumen" } } : {}) },
];
if (brotkrumen) graph.push({ "@type": "BreadcrumbList", "@id": canonical + "#brotkrumen", itemListElement: brotkrumen.map((x: any, i: number) => ({ "@type": "ListItem", position: i + 1, name: x.name, item: basis + x.pfad })) });
if (dienst) graph.push({ "@type": "Service", "@id": basis + dienst.pfad + "#leistung", name: dienst.titel, serviceType: dienst.titel, description: dienst.beschreibung || dienst.kurz, url: basis + dienst.pfad,
  provider: { "@id": basis + "/#betrieb" }, areaServed: area, ...(dienst.marke ? { brand: { "@type": "Brand", name: dienst.marke } } : {}) });
for (const x of ldExtra) graph.push(x);
if (faq) graph.push({ "@type": "FAQPage", mainEntity: faq.map((f: any) => ({ "@type": "Question", name: f.frage, acceptedAnswer: { "@type": "Answer", text: f.antwort } })) });
const ld = { "@context": "https://schema.org", "@graph": graph };
const zeigeLd = !istFehlerseite; // alle Seiten ausser 404 (vorher nur mit jsonld/brotkrumen/faq)
---
<!doctype html>
<html lang="de-CH" data-zaehl-endpunkt={process.env.ZAEHL_ENDPUNKT || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{s.titel}</title>
{s.beschreibung && <meta name="description" content={s.beschreibung}>}
{!istFehlerseite && <link rel="canonical" href={canonical}>}
{vorschau && <meta name="robots" content="noindex">}
{process.env.GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={process.env.GOOGLE_SITE_VERIFICATION}>}
<meta name="theme-color" content="#fbfaf8">
<link rel="icon" href="/bilder/icons/favicon.ico" sizes="any">
<link rel="icon" type="image/svg+xml" href="/bilder/icons/icon.svg">
<link rel="apple-touch-icon" href="/bilder/icons/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content={b.name}>
<meta property="og:title" content={s.titel}>
{s.beschreibung && <meta property="og:description" content={s.beschreibung}>}
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogAbs}>
<meta property="og:locale" content="de_CH">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={s.titel}>
{s.beschreibung && <meta name="twitter:description" content={s.beschreibung}>}
<meta name="twitter:image" content={ogAbs}>
{bildVorladen && <link rel="preload" as="image" href={bildVorladen.href} imagesrcset={bildVorladen.srcset} imagesizes={bildVorladen.sizes} fetchpriority="high">}
<link rel="preload" href="/fonts/source-serif-4-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/source-serif-4-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/klar.css">
{zeigeLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>}
<script is:inline src="/js/klar.js" defer></script>
<script is:inline src="/js/zaehl.js" defer></script>
</head>
<body data-seite={seite}>
<a class="sprung" href="#inhalt">{texte.mikrotexte.sprunglink}</a>
<Hinweis />
<Kopf aktiv={Astro.url.pathname} />
<main id="inhalt">
<slot />
</main>
<Fuss ort={seite} />
{/* Vorschau-Plakette am Schluss (QA K15): am Computer weiter fix unten links, am Handy als ruhige Zeile unter dem Fuss,
    damit sie keinen Inhalt und keine Knöpfe verdeckt. */}
{vorschau && <p data-vorschau>{texte.mikrotexte.vorschauHinweis}</p>}
{seite !== "schaden-melden" && (
  <nav class="handyleiste" aria-label="Schnellkontakt">
    <a class="knopf knopf--kontur" href={`tel:${b.tel.e164}`} data-zaehl="anruf" data-ort="leiste"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Anrufen</a>
    <a class="knopf knopf--akzent" href="/schaden-melden/" data-zaehl="anfrage" data-ort="leiste">Schaden melden</a>
  </nav>
)}
</body>
</html>
