import Bewertungen from "../components/Bewertungen.astro";
import Faq from "../components/Faq.astro";
import Umwelt from "../components/Umwelt.astro";
import { faqStart } from "../daten/faq";
---
<Klar seite="index" jsonld faq={faqStart} bildVorladen={{ href: "/bilder/defender-kabine-960.webp", srcset: "/bilder/defender-kabine-480.webp 480w, /bilder/defender-kabine-960.webp 960w, /bilder/defender-kabine-1600.webp 1600w", sizes: "(max-width: 760px) 100vw, 46vw" }}>

<Hero />
