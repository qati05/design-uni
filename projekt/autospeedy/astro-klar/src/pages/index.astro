---
// Startseite der Linie «Klar». Wortlaut nur aus fakten.md und der ersten Linie (texte.json, arten.json), nichts Neues behauptet.
// Nachtrag 04.11.2026: 6 Leistungskarten (mit Bild), kein Felgen-Vorher/Nachher mehr auf der Startseite (wandert auf
// /leistungen/felgen/), Google-Bewertungen mit Zitaten (nur Vorschau), Fragen/Antworten (AEO) und JSON-LD (FAQPage + Betrieb).
import Klar from "../layouts/Klar.astro";
import Hero from "../components/Hero.astro";
import Faktenleiste from "../components/Faktenleiste.astro";
import Partnerband from "../components/Partnerband.astro";
