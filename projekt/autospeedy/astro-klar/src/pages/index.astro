---
// Startseite (Entscheid Roni, 09.11.2026 abends): die Fassung nach den Regeln aus github.com/Nutlope/hallmark
// (Redesign «full» der früheren Klar-Startseite: Inhalt und Verdrahtung gleich, Aufbau und Komposition neu).
// Inhalt: Wortlaut nur aus fakten.md, texte.json und arten.json; Daten aus betrieb, leistungen, faq und site.json
// (Fragen, Partner, Fotos und Team pflegt der Betrieb im Cockpit). Farben und Schriften: Klar (public/css/hallmark/tokens.css).
// Kopf und Fuss: gemeinsames Markup, der Kopf wird auf dieser Seite per CSS zur schwebenden Leiste.
// Bewegung (Hallmark, microinteractions.md): ein Auftritt beim Laden, ein Einblenden beim Rollen (data-reveal, einmal),
// ein Zeichen beim Überfahren. Nur transform und opacity, alles mit Rückfall unter «Bewegung reduzieren».
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import Klar from "../layouts/Klar.astro";
import Bild from "../components/Bild.astro";
import Partnerband from "../components/Partnerband.astro";
import { betrieb as b, site, vorschau } from "../../../astro/bau/daten.mjs";
import artenDaten from "../../../astro/src/content/arten.json";
import { leistungen } from "../daten/leistungen";
import { faqStart } from "../daten/faq";
import { umwelt } from "../daten/umwelt";
import { zeitenOffen as offen } from "../daten/zeiten";
import zitDaten from "../daten/bewertungen-zitate.json";

const arten = (artenDaten as any).arten;

// Schritte nach der Meldung: Wortlaut aus Ablauf.astro.
const schritte = [
  { titel: "Wir rufen zurück", text: "In der Regel telefonisch in den Öffnungszeiten. Fehlendes klären wir dann gemeinsam." },
  { titel: "Offerte und Termin", text: "Was die Reparatur kostet, hängt vom Schaden ab. Die Offerte und den Termin besprechen wir persönlich mit Ihnen." },
  { titel: "Wir reparieren", text: "Die Abwicklung mit Ihrer Versicherung übernehmen wir. Einen Ersatzwagen erhalten Sie auf Anfrage." },
];

// Team: dieselbe Logik wie Inhaber.astro (nur Personen mit Einverständnis und Foto; Zitat erst nach Freigabe).
const stimme = (site as any).stimme;
const freigegeben = !!(stimme && stimme.freigegeben);
const leute = (site as any).team.flatMap((g: any) => g.leute).filter((p: any) => p.einverstaendnis && p.foto);
const chef = leute[0];
const reihe = leute.slice(freigegeben ? 1 : 0, (freigegeben ? 1 : 0) + 4);
const kurz = (n: string) => n.replace(/ «.*»/, "");

// Bewertungen: dieselbe Logik wie Bewertungen.astro (echte Daten live; Zitate nur in der Vorschau).
const zeigeBew = (site as any).bewertungen ? (site as any).bewertungen.zeigen !== false : true;
const bewDatei = process.env.BEWERTUNGEN_DATEI
  ? path.resolve(process.cwd(), process.env.BEWERTUNGEN_DATEI)
  : fileURLToPath(new URL("../daten/bewertungen.json", import.meta.url));
let bew: any = { status: "leer" };
try { bew = JSON.parse(fs.readFileSync(bewDatei, "utf8")); } catch { bew = { status: "leer" }; }
const hatBew = bew && bew.status === "ok" && typeof bew.note === "number" && typeof bew.anzahl === "number";
const bewNote = hatBew ? bew.note.toFixed(1).replace(".", ",") : "";
const mapsLink: string | null = hatBew && typeof bew.maps_link === "string" ? bew.maps_link : null;
const schreiben = (b as any).bewertungen && (b as any).bewertungen.google ? (b as any).bewertungen.google : null;
const zitate: any[] = Array.isArray((zitDaten as any).zitate) ? (zitDaten as any).zitate : [];
const zitNote: number | null = typeof (zitDaten as any).note === "number" ? (zitDaten as any).note : null;
const zitNoteText = zitNote == null ? "" : zitNote.toFixed(1).replace(".", ",");
const zeigeZitate = vorschau && !hatBew && zitate.length > 0;

// Umwelt: nur mit bestätigten Angaben des Betriebs (heute leer, siehe src/daten/umwelt.ts).
const umweltPunkte = umwelt.bestaetigt ? umwelt.punkte : [];

const band = "/bilder/stock/b7-tesla";
// Fotos, die der Betrieb im Cockpit ersetzt hat (site.json, Feld «bilder»), gehen den Fotos der Website vor.
const ersatz = (site as any).bilder ?? {};
const startFoto = ersatz.start ?? null;
---
<Klar seite="index" jsonld faq={faqStart} bildVorladen={startFoto ? { href: startFoto.foto } : { href: "/bilder/defender-kabine-1600.webp", srcset: "/bilder/defender-kabine-480.webp 480w, /bilder/defender-kabine-960.webp 960w, /bilder/defender-kabine-1600.webp 1600w", sizes: "(max-width: 960px) 100vw, 54vw" }}>
<Fragment slot="kopf">
<link rel="stylesheet" href="/css/hallmark/base.css">
<link rel="stylesheet" href="/css/hallmark/seite.css">
</Fragment>


<section class="hero hm hm-hero">
  {/* Kundenwunsch (Roni, 09.11.2026): kein Vollbild-Hero. Text links, Foto im Rahmen rechts. */}
  <div class="container hm-hero__raster">
    <div class="hm-hero__text">
      <h1>Qualität,<br> <span>die man sieht</span> <span>und fährt.</span></h1>
      <p class="lead">Carrosserie und Lack in Altstätten, für alle Marken und als Tesla Approved Body Shop. Die Abwicklung mit Ihrer Versicherung übernehmen wir. Einen Ersatzwagen erhalten Sie auf Anfrage.</p>
      <div class="hm-hero__seite">
        {/* Klassen «hero» und «ctas» bleiben, weil klar.js daran die Handyleiste ein- und ausblendet. */}
        <div class="ctas hm-ctas">
          <a class="btn" href="/schaden-melden/">Schaden melden</a>
          <a class="btn btn--quiet" href={`tel:${b.tel.e164}`}>Anrufen <span class="num">{b.tel.anzeige}</span></a>
        </div>
        <p class="hm-status" data-hero-status hidden><span data-status></span><span data-wenn-zu hidden> Online melden geht jederzeit, wir rufen Sie zurück.</span></p>
      </div>
    </div>
    <figure class="hm-hero__bild">
      <Bild name="defender-kabine" platz="start" alt="Land Rover Defender in der hell beleuchteten Kabine der Werkstatt" sizes="(max-width: 960px) 100vw, 54vw" lcp />
    </figure>
  </div>
  <nav class="hm-frage" aria-labelledby="hm-frage-titel">
    <div class="container hm-frage__innen">
      <p class="hm-frage__titel" id="hm-frage-titel">Was ist passiert?</p>
      <ul class="hm-frage__liste">
        {arten.map((a: any) => <li><a href={`/schaden-melden/?art=${a.id}`}>{a.name}</a></li>)}
        <li class="hm-frage__tesla"><a href="/schaden-melden/?fahrzeug=tesla">Tesla? Hier entlang</a></li>
      </ul>
    </div>
  </nav>
</section>

<section class="hm hm-fakten" aria-label="Der Betrieb in Kürze">
  <div class="container">
    <dl class="hm-fakten__liste" data-reveal>
      <div>
        <dt>Ort</dt>
        <dd>{b.strasse}<br>{b.plz} {b.ort} {b.kanton}</dd>
      </div>
      <div>
        <dt>Öffnungszeiten</dt>
        <dd>{offen.map((zeile: string, i: number) => <>{i > 0 && <br />}{zeile}</>)}</dd>
      </div>
      <div>
        <dt>Ersatzwagen</dt>
        <dd><span class="num">{b.ersatzwagen.anzahl}</span> Ersatzautos auf Anfrage{b.ersatzwagen.tesla ? ", auch ein Tesla" : ""}</dd>
      </div>
      <div>
        <dt>Zulassung</dt>
        <dd>Tesla Approved Body Shop</dd>
      </div>
      {hatBew && (
        <div>
          <dt>Bewertung</dt>
          <dd><span class="num">{bewNote}</span> von 5 bei <span class="num">{bew.anzahl}</span> Bewertungen auf Google</dd>
        </div>
      )}
    </dl>
  </div>
  <Partnerband titel="Zertifizierte Partner" />
</section>

<section class="hm hm-leist" id="leistungen" aria-labelledby="leistungen-titel">
  <div class="container">
    <h2 id="leistungen-titel" data-reveal>Was wir für Sie machen.</h2>
    <ul class="hm-index" data-reveal-liste>
      {leistungen.map((k) => (
        <li>
          <a href={k.pfad}>
            <picture class="hm-index__bild">
              <source type="image/avif" srcset={`/bilder/leistungen/${k.slug}-400.avif 400w, /bilder/leistungen/${k.slug}-800.avif 800w`} sizes="(max-width: 640px) 112px, 30vw" />
              <source type="image/webp" srcset={`/bilder/leistungen/${k.slug}-400.webp 400w, /bilder/leistungen/${k.slug}-800.webp 800w`} sizes="(max-width: 640px) 112px, 30vw" />
              {ersatz[`leistung-${k.slug}`]
                ? <img src={ersatz[`leistung-${k.slug}`].foto} width={ersatz[`leistung-${k.slug}`].b} height={ersatz[`leistung-${k.slug}`].h} loading="lazy" decoding="async" alt={ersatz[`leistung-${k.slug}`].alt} />
                : <img src={`/bilder/leistungen/${k.slug}-800.webp`} width="800" height="533" loading="lazy" decoding="async" alt={k.altKarte} />}
            </picture>
            <h3>{k.titel}</h3>
            <p>{k.kurz}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="hm-leist__ausserdem"><span>Ausserdem: Occasionen und Ankauf. <a href="/occasionen/">Occasionen ansehen</a>.</span></p>
  </div>
</section>

<section class="hm hm-ablauf" aria-labelledby="ablauf-titel">
  <div class="container hm-ablauf__raster">
    <div class="hm-ablauf__kopf" data-reveal>
      <h2 id="ablauf-titel">Nach Ihrer Meldung geht es so weiter.</h2>
      <p class="lead"><strong>Ein Schaden am Auto?</strong> Melden Sie ihn online mit ein paar Fotos, oder rufen Sie uns direkt an.</p>
      <div class="hm-ctas">
        <a class="btn" href="/schaden-melden/">Schaden melden</a>
        <a class="btn btn--quiet" href={`tel:${b.tel.e164}`}>Anrufen <span class="num">{b.tel.anzeige}</span></a>
      </div>
    </div>
    <ol class="hm-schritte" data-reveal-liste>
      {schritte.map((s) => (
        <li>
          <h3>{s.titel}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<section id="tesla" class="hm hm-tesla" aria-labelledby="tesla-titel">
  <div class="container">
    <div class="hm-tesla__kopf" data-reveal>
      <h2 id="tesla-titel">Tesla Approved Body Shop.</h2>
      <p class="lead">Wir reparieren Ihren Tesla als zugelassener Carrosserie-Partner, nach den Reparaturvorgaben von Tesla und mit Original-Ersatzteilen.</p>
    </div>
    <figure class="hm-tesla__bild" data-reveal>
      <img
        src={`${band}-1280.webp`}
        srcset={`${band}-640.webp 640w, ${band}-1280.webp 1280w, ${band}-1920.webp 1920w`}
        sizes="(max-width: 1440px) 92vw, 1312px"
        width="1280" height="549"
        loading="lazy" decoding="async"
        alt="Scheinwerfer eines schwarzen Tesla Model S">
      <figcaption>Platzhalter von Unsplash (Philipp Mandler), wird durch ein eigenes Foto ersetzt.</figcaption>
    </figure>
    <div class="hm-tesla__unten" data-reveal>
      <dl class="hm-spec">
        <div><dt>Teile</dt><dd>Original-Ersatzteile</dd></div>
        <div><dt>Versicherung</dt><dd>Abwicklung durch uns</dd></div>
        <div><dt>Lack</dt><dd>Neue, grössere Lackierkabinen</dd></div>
        <div><dt>Ersatzwagen</dt><dd>Tesla auf Anfrage</dd></div>
      </dl>
      <div class="hm-tesla__weg">
        <ol class="hm-tesla__ablauf">
          <li><b>Melden</b><span>Online mit Fotos oder per Telefon.</span></li>
          <li><b>Begutachten</b><span>Prüfung am Fahrzeug, Original-Teile bestellen, Versicherung klären.</span></li>
          <li><b>Reparieren</b><span>Instandsetzung nach Tesla-Vorgaben, Übergabe mit Erklärung.</span></li>
        </ol>
        <p class="hm-tesla__hinweis">Entwurf: Ablauf vom Betrieb zu bestätigen.</p>
        <a class="btn" href="/schaden-melden/?tesla=1">Tesla-Schaden melden</a>
      </div>
    </div>
  </div>
</section>

{umweltPunkte.length > 0 && (
<section id="umwelt" class="hm hm-umwelt" aria-labelledby="umwelt-titel">
  <div class="container">
    <h2 id="umwelt-titel">Was wir für die Umwelt tun.</h2>
    <ul class="hm-umwelt__liste">
      {umweltPunkte.map((p: any) => <li><h3>{p.titel}</h3><p>{p.text}</p></li>)}
    </ul>
  </div>
</section>
)}

<section id="team" class="hm hm-team" aria-labelledby="team-titel">
  <div class="container">
    <div class="hm-team__kopf" data-reveal>
      <h2 id="team-titel">Zehn Leute, eine Werkstatt.</h2>
      <p class="lead">An der Alten Landstrasse in Altstätten, von der Annahme bis zum Finish.</p>
    </div>
    {freigegeben && chef && (
      <figure class="hm-team__stimme">
        <img src={chef.foto} width="640" height="800" loading="lazy" decoding="async" alt={`Porträt ${kurz(chef.name)}`}>
        <blockquote><p>{stimme.text}</p><footer>{[stimme.name, stimme.rolle].filter(Boolean).join(", ")}</footer></blockquote>
      </figure>
    )}
    <ul class="hm-leute" data-reveal-liste>
      {reihe.map((p: any) => (
        <li>
          <figure>
            <img src={p.foto} width="640" height="800" loading="lazy" decoding="async" alt={`Porträt ${kurz(p.name)}`}>
            <figcaption><b>{p.name}</b><span>{p.rolle}</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="hm-team__mehr"><a class="btn btn--quiet" href="/team/">Ganzes Team</a></p>
  </div>
</section>

{zeigeBew && hatBew && (
<section class="hm hm-bew" aria-labelledby="bewertungen-titel">
  <div class="container hm-bew__raster" data-reveal>
    <div class="hm-bew__kopf">
      <h2 id="bewertungen-titel">Was Kundinnen und Kunden auf Google schreiben.</h2>
    </div>
    <div class="hm-bew__echt">
      <p class="hm-bew__note"><span class="num">{bewNote}</span> von 5 bei <span class="num">{bew.anzahl}</span> Bewertungen</p>
      <p class="hm-bew__quelle">Bewertungen von Google</p>
      <p class="hm-bew__links">
        {mapsLink && <a href={mapsLink} rel="noopener">Alle Bewertungen auf Google</a>}
        {schreiben && <a href={schreiben} rel="noopener">Bewertung schreiben</a>}
      </p>
    </div>
  </div>
</section>
)}

{zeigeBew && zeigeZitate && (
<section class="hm hm-bew" aria-labelledby="bew-vorschau-titel">
  <div class="container hm-bew__raster" data-reveal>
    <div class="hm-bew__kopf">
      <h2 id="bew-vorschau-titel">Was Kundinnen und Kunden auf Google schreiben.</h2>
      <p class="hm-bew__note"><span class="num">{zitNoteText}</span> von 5 auf Google</p>
      <p class="hm-bew__hinweis" data-luecke>Nur in der Vorschau. Vor dem Livegang übernehmen wir Zitate, Namen, Datum und Anzahl wörtlich aus dem Google-Unternehmensprofil; dann wird dieser Abschnitt live geschaltet.</p>
    </div>
    <div>
      <ul class="hm-zitate">
        {zitate.slice(0, 3).map((z: any) => (
          <li>
            <figure>
              <blockquote>{z.text}</blockquote>
              <figcaption>{z.name || "Name folgt"}, Google</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
)}

<section class="hm hm-faq" aria-labelledby="faq-titel">
  <div class="container">
    <h2 id="faq-titel" data-reveal>Häufige Fragen</h2>
    <div class="hm-faq__liste">
      {faqStart.map((f: any, i: number) => (
        <details open={i === 0 ? true : undefined}>
          <summary><h3>{f.frage}</h3><span class="hm-faq__zeichen" aria-hidden="true"></span></summary>
          <p>{f.antwort}</p>
        </details>
      ))}
    </div>
  </div>
</section>

</Klar>
