---
// Fehlender Text zu den Folierungen bleibt eine sichtbare Lücke.
import LeistungSeite from "../../components/LeistungSeite.astro";
import Bild from "../../components/Bild.astro";
import Luecke from "../../components/Luecke.astro";
---
<LeistungSeite slug="folierung">
<section class="abschnitt abschnitt--flaeche" aria-labelledby="folierung-titel">
  <div class="abschnitt__innen">
    <div class="abschnitt__kopf"><h2 id="folierung-titel">Beispiele aus der Werkstatt.</h2></div>
    <div class="raster raster--zwei">
      <Bild name="defender-seite" alt="Defender in Grau von der Seite, Türen offen" sizes="(max-width: 960px) 100vw, 50vw" />
      <Bild name="defender-kabine" alt="Defender in mattem Grau von vorne in der hellen Kabine" sizes="(max-width: 960px) 100vw, 50vw" />
    </div>
    <Luecke>Lücke: Welche Folierungen Auto Speedy anbietet, steht auf der bisherigen Website nur als Bild. Den Text liefert der Betrieb.</Luecke>
  </div>
</section>
</LeistungSeite>
