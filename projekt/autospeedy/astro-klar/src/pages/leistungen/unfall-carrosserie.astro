---
import LeistungSeite from "../../components/LeistungSeite.astro";
import Arbeiten from "../../components/Arbeiten.astro";
const punkte = [
  { titel: "Unfallschäden", text: "Vom kleinen Blechschaden bis zum Chassis richten und ersetzen wir, was beschädigt ist." },
  { titel: "Stossstangen", text: "Risse und Kratzer reparieren wir, wenn das sinnvoll ist, statt gleich zu ersetzen." },
  { titel: "Rost", text: "Wir behandeln ihn an der Stelle, bevor er sich weiterfrisst." },
  { titel: "Schweissarbeiten", text: "Nach Herstellervorgaben, auch an grösseren Schäden." },
];
---
<LeistungSeite slug="unfall">
<Arbeiten bild="abgeklebt" alt="Fahrzeug an der Front mit Folie abgeklebt, zum Lackieren vorbereitet" punkte={punkte} zeile="Auch Lieferwagen, Anhänger, Wohnmobile und Oldtimer reparieren wir." />
</LeistungSeite>
