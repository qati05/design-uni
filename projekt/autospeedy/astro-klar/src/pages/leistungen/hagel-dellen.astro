---
import LeistungSeite from "../../components/LeistungSeite.astro";
import Arbeiten from "../../components/Arbeiten.astro";
const punkte = [
  { titel: "Hagelschäden", text: "Dach, Motorhaube und Kofferraumdeckel nehmen wir uns Stelle für Stelle vor." },
  { titel: "Dellendrücken", text: "Ist der Lack heil, drücken wir die Delle heraus, ganz ohne Lackieren." },
  { titel: "Richten und Lackieren", text: "Ist der Lack gerissen oder die Delle zu tief, richten wir das Blech und lackieren neu." },
];
---
<LeistungSeite slug="hagel">
<Arbeiten bild="dellen" alt="Mitarbeiter mit Werkzeug zum Dellendrücken an einem weissen Auto" punkte={punkte} />
</LeistungSeite>
