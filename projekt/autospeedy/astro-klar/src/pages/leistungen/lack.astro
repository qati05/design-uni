---
import LeistungSeite from "../../components/LeistungSeite.astro";
import Bild from "../../components/Bild.astro";
---
<LeistungSeite slug="lack">
<section class="abschnitt abschnitt--flaeche">
  <div class="abschnitt__innen">
    <div class="zeilen">
      <div class="zeile"><Bild name="lackierkabine" alt="Lackierer in Schutzkleidung in der Lackierkabine, Fahrzeug blau abgeklebt" sizes="(max-width: 960px) 100vw, 50vw" /><div><h2>Was wir lackieren</h2><ul class="liste"><li>einfache Lackschäden</li><li>komplette Neulackierung</li><li>Versicherungsfälle</li><li>Restaurationen</li><li>Lackieren aller Gegenstände</li></ul></div></div>
      <div class="zeile"><Bild name="politur" alt="Mitarbeiterin poliert die Seite eines roten Ferrari" sizes="(max-width: 960px) 100vw, 50vw" /><div><h2>Aufpolieren und Aufbereitung</h2><ul class="liste"><li>Aufpolieren</li><li>Fahrzeugaufbereitung</li></ul></div></div>
    </div>
  </div>
</section>
</LeistungSeite>
