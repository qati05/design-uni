---
import LeistungSeite from "../../components/LeistungSeite.astro";
import Arbeiten from "../../components/Arbeiten.astro";
const punkte = [
  { titel: "Kleine Lackschäden", text: "Kratzer und Schrammen beheben wir mit möglichst wenig Aufwand." },
  { titel: "Neulackierung", text: "Ganze Fahrzeuge lackieren wir in neuen, grösseren Kabinen." },
  { titel: "Restaurationen", text: "Auch ältere Fahrzeuge bringen wir wieder in Form." },
  { titel: "Aufpolieren und Aufbereitung", text: "Damit der Lack wieder glänzt und das Auto innen und aussen stimmt." },
];
---
<LeistungSeite slug="lack">
<Arbeiten bild="politur" alt="Mitarbeiterin poliert die Seite eines roten Ferrari" punkte={punkte} zeile="Neben Autos lackieren wir auch andere Gegenstände. Fragen Sie uns einfach." />
</LeistungSeite>
