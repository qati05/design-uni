---
import Klar from "../layouts/Klar.astro";
import Kopfbild from "../components/Kopfbild.astro";
import Luecke from "../components/Luecke.astro";
import { site } from "../../../astro/bau/daten.mjs";
// Nur Personen mit Einverstaendnis werden gezeigt (site.ts, BAUPLAN 2 Zeile 9 / 4.2). Ohne Zustimmung: Platzhalter unten.
const gruppen = site.team
  .map((g: any) => ({ ...g, leute: g.leute.filter((p: any) => p.einverstaendnis) }))
  .filter((g: any) => g.leute.length);
---
<Klar seite="team">
<Kopfbild titel="Zehn Leute, fünf Bereiche." foto="team-kabine" alt="Mitarbeiter in der Lackierkabine neben einer abgeklebten Fahrzeugtür">
  <p>Von der Annahme bis zum Finish: So ist das Team von Auto Speedy aufgeteilt.</p>
</Kopfbild>
<section class="abschnitt">
  <div class="abschnitt__innen">
    {gruppen.map((g: any) => (
      <div class="gruppe">
        <h2>{g.name}</h2>
        <div class="leute leute--seite">
          {g.leute.map((p: any) => (
            <figure>
              {p.foto ? <img src={p.foto} width="320" height="320" loading="lazy" decoding="async" alt={`Porträt ${p.name.replace(/ «.*»/, "")}`}> : <span class="leute__leer" aria-hidden="true">{p.name.split(" ").map((w: string) => w[0]).slice(0, 2).join("")}</span>}
              <figcaption><b>{p.name}</b><span>{p.rolle}</span>{p.email && <a href={`mailto:${p.email}`} data-zaehl="mail" data-ort="team">{p.email}</a>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
    <Luecke>Lücke: Wir zeigen hier nur Personen, die der Veröffentlichung zugestimmt haben. Namen, Rollen und Porträts stammen von der bisherigen Website; das Einverständnis klärt der Betrieb.</Luecke>
    <h2 class="abstand">Ausbildung und Stellen</h2>
    <p class="text-gross">Auto Speedy ist Ausbildungsbetrieb, unter anderem für Carrosserielackierer/-in EFZ (laut Carrosserie Suisse). Zurzeit sind keine Stellen offen (Stand der bisherigen Website).</p>
  </div>
</section>
</Klar>
