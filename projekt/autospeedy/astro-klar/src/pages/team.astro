---
import Klar from "../layouts/Klar.astro";
import Kopfbild from "../components/Kopfbild.astro";
import { site } from "../../../astro/bau/daten.mjs";
import { teamTitelSeite } from "../daten/team";
// Namen, Rollen und Porträts wie auf autospeedy.ch/team; der Betrieb erlaubt die Übernahme (Roni, 04.11.2026). Das Feld einverstaendnis bleibt die Pflege-Sperre im Cockpit.
const gruppen = site.team
  .map((g: any) => ({ ...g, leute: g.leute.filter((p: any) => p.einverstaendnis) }))
  .filter((g: any) => g.leute.length);
// Nachtrag 08.11.2026 (AEO): Personen als JSON-LD mit Rolle und Bezug zum Betrieb (ohne E-Mail-Adressen).
import { bau } from "../../../astro/bau/daten.mjs";
const basis = (bau.adresse || "https://www.autospeedy.ch").replace(/\/$/, "");
const personen = gruppen.flatMap((g: any) => g.leute.map((p: any) => {
  const spitz = p.name.match(/«(.+)»/);
  return { "@type": "Person", name: p.name.replace(/ «.*»/, ""), ...(spitz ? { alternateName: spitz[1] } : {}), jobTitle: p.rolle, ...(p.foto ? { image: basis + p.foto } : {}), worksFor: { "@id": basis + "/#betrieb" } };
}));
---
<Klar seite="team" brotkrumen={[{ name: "Startseite", pfad: "/" }, { name: "Team", pfad: "/team/" }]} ldExtra={personen}>
<Kopfbild titel={teamTitelSeite} foto="team-kabine" alt="Mitarbeiter in der Lackierkabine neben einer abgeklebten Fahrzeugtür">
  <p>Von der Annahme bis zum Finish: So ist das Team von Auto Speedy aufgeteilt.</p>
</Kopfbild>
<section class="abschnitt">
  <div class="abschnitt__innen">
    {gruppen.map((g: any) => (
      <div class="gruppe">
        <h2>{g.name}</h2>
        {/* QA K07: Raster nach der Zahl der Personen (data-anzahl), damit keine leere Spalte bleibt. QA K17: Mail bricht nur nach «@». */}
        <div class="leute leute--seite" data-anzahl={g.leute.length}>
          {g.leute.map((p: any) => (
            <figure>
              {p.foto ? <img src={p.foto} width="640" height="800" loading="lazy" decoding="async" alt={`Porträt ${p.name.replace(/ «.*»/, "")}`}> : <span class="leute__leer" aria-hidden="true">{p.name.split(" ").map((w: string) => w[0]).slice(0, 2).join("")}</span>}
              <figcaption><b>{p.name}</b><span>{p.rolle}</span>{p.email && <a href={`mailto:${p.email}`}>{p.email.split("@")[0]}@<wbr />{p.email.split("@").slice(1).join("@")}</a>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
    <h2 class="abstand">Ausbildung und Stellen</h2>
    <p class="text-gross">Auto Speedy ist Ausbildungsbetrieb, unter anderem für Carrosserielackierer/-in EFZ (laut Carrosserie Suisse). Zurzeit sind keine Stellen offen (Stand der bisherigen Website).</p>
  </div>
</section>
</Klar>
