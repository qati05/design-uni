---
// Druckvorlage A6 (BAUPLAN 4.6): QR-Code auf /bewerten/?q=qr plus ein kurzer Satz. Eigenständige Seite ohne die
// Website-Hülle, noindex (nicht im Index, nicht in der Sitemap — siehe astro/bau/dateien.mjs). Der QR-Code
// (public/bewerten/qr.svg) entsteht beim Build über bau/qr.mjs. Kein Inline-Skript (CSP); nur Stil (style-src erlaubt).
import { betrieb as b } from "../../../../astro/bau/daten.mjs";
---
<!doctype html>
<html lang="de-CH">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Bewerten · Druckvorlage · {b.name}</title>
<link rel="stylesheet" href="/css/klar.css">
<style>
  @page { size: A6; margin: 0; }
  html, body { margin: 0; padding: 0; background: #fff; }
  .a6 { box-sizing: border-box; width: 105mm; height: 148mm; margin: 0 auto; padding: 12mm 10mm; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 7mm; color: var(--tinte); }
  .a6 h1 { font-family: "Source Serif 4", Georgia, serif; font-size: 22pt; line-height: 1.15; margin: 0; }
  .a6 p { font-size: 12pt; margin: 0; color: var(--leise); }
  .a6 img { width: 55mm; height: 55mm; }
  .a6 .marke { font-weight: 600; color: var(--tinte); }
  @media screen { body { background: var(--grund); padding: 24px; } .a6 { border: 1px solid var(--linie); background: #fff; } }
  /* Prüfung 10.11.2026, Befund 20: Am Handy ist das Blatt (105 mm) breiter als der Bildschirm. Nur in der Ansicht am
     Bildschirm passt es sich der Breite an und behält das Seitenverhältnis A6; der Druck bleibt unverändert A6. */
  @media screen and (max-width: 480px) {
    body { padding: 16px; }
    .a6 { width: 100%; height: auto; min-height: calc((100vw - 32px) * 148 / 105); padding: 10mm 8mm; }
    .a6 img { max-width: 100%; height: auto; }
  }
</style>
</head>
<body>
<div class="a6">
  <h1>Danke für Ihren Auftrag.</h1>
  <p>Eine Bewertung hilft uns.</p>
  <img src="/bewerten/qr.svg" alt="QR-Code zur Bewertungsseite" width="208" height="208">
  <p class="marke">{b.name}</p>
</div>
</body>
</html>
