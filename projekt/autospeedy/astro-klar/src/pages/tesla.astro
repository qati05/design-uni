---
import Klar from "../layouts/Klar.astro";
import Luecke from "../components/Luecke.astro";
import Faq from "../components/Faq.astro";
import { faqTesla } from "../daten/faq";
// Tesla-Seite (Nachtrag 04.11., C14/C15): kein Raster, kein Glow, keine Pill mit Punkt. Marke als ruhiger Eyebrow,
// gerahmtes Foto wie auf der Startseite (AVIF + WebP), Liste ohne Pseudo-Navigation, Schritte auf einer Linie,
// kurze Tesla-FAQ aus Fakten, am Ende CTA «Tesla-Schaden melden» (→ /schaden-melden/?fahrzeug=tesla, vom Formular unterstützt).
// Nur belegte Aussagen (Tesla Approved Body Shop, Original-Ersatzteile, Ersatzwagen Tesla auf Anfrage).
// Foto B7 als AVIF/WebP 640/1280/1920 aus public/bilder/stock/. Platzhalter von Unsplash (Philipp Mandler), Credit unter /bildnachweise/.
const band = "/bilder/stock/b7-tesla";
const brotkrumen = [{ name: "Startseite", pfad: "/" }, { name: "Tesla", pfad: "/tesla/" }];
---
<Klar seite="tesla" brotkrumen={brotkrumen} faq={faqTesla} dienst={{ titel: "Tesla-Carrosseriereparatur", pfad: "/tesla/", kurz: "Unfall-, Lack- und Hagelschäden am Tesla nach Tesla-Vorgaben mit Original-Ersatzteilen, als Tesla Approved Body Shop.", marke: "Tesla" }}>
<section class="tesla tesla--seite" aria-labelledby="t-titel">
  <div class="tesla__innen">
    <div class="tesla__kopf">
      <h1 id="t-titel">Ihr Tesla. <em>In zugelassenen Händen.</em></h1>
      <p>Auto Speedy ist von Tesla als Carrosseriewerkstatt zugelassen. Melden Sie den Schaden an Ihrem Tesla direkt hier; das Formular wählt «Tesla» schon aus, das Modell tippen Sie an.</p>
      <ul class="tesla__liste">
        <li>Unfall- und Blechschäden</li>
        <li>Lackschäden und Neulackierung</li>
        <li>Hagelschäden und Dellen</li>
        <li>Abwicklung mit Ihrer Versicherung</li>
      </ul>
      <div class="knoepfe"><a class="k k--blau" href="/schaden-melden/?fahrzeug=tesla" data-zaehl="anfrage-tesla" data-ort="tesla">Tesla-Schaden melden</a></div>
    </div>
    <figure class="tesla__foto foto-ein">
      <span class="tesla__rahmen">
        <picture>
          <source type="image/avif" srcset={`${band}-640.avif 640w, ${band}-1280.avif 1280w, ${band}-1920.avif 1920w`} sizes="(max-width: 960px) 100vw, 44vw" />
          <source type="image/webp" srcset={`${band}-640.webp 640w, ${band}-1280.webp 1280w, ${band}-1920.webp 1920w`} sizes="(max-width: 960px) 100vw, 44vw" />
          <img src={`${band}-1280.webp`} width="1280" height="549" loading="lazy" decoding="async" alt="Scheinwerfer eines schwarzen Tesla Model S">
        </picture>
      </span>
      <figcaption>Platzhalter von Unsplash (Philipp Mandler), wird durch ein eigenes Foto ersetzt.</figcaption>
    </figure>
  </div>
</section>
{/* QA C09: volle Inhaltsbreite; Modelle als Häkchenliste (Information, keine Knöpfe), Modelle und «Gut zu wissen»
    am Computer nebeneinander, ohne Leerblock vor den Fragen. Wortlaut unverändert. */}
<section class="abschnitt tesla-infos">
  <div class="abschnitt__innen">
    <h2>So läuft es</h2>
    <ol class="tesla-schritte">
      <li><b>Melden</b><span>Online mit Fotos oder per Telefon.</span></li>
      <li><b>Begutachten</b><span>Prüfung am Fahrzeug, Original-Teile bestellen, Versicherung klären.</span></li>
      <li><b>Reparieren</b><span>Instandsetzung nach Tesla-Vorgaben, Übergabe mit Erklärung.</span></li>
    </ol>
    <Luecke>Entwurf: Den genauen Ablauf für Tesla bestätigt der Betrieb noch.</Luecke>
    <div class="tesla-infos__zwei">
      <div>
        <h2>Modelle</h2>
        <p class="text-gross">Im Formular wählen Sie Model 3, Model Y, Model S oder Model X. So wissen wir gleich, welches Auto kommt.</p>
        <ul class="tesla__liste tesla__liste--modelle" aria-hidden="true">{["Model 3", "Model Y", "Model S", "Model X"].map((m) => <li>{m}</li>)}</ul>
        <Luecke>Lücke: Ob für Tesla weitere Leistungen gelten (zum Beispiel Kalibrierung oder ein eigener Ablauf mit Tesla), sagt der Betrieb noch. Die Liste oben nennt die allgemeinen Leistungen der Carrosserie.</Luecke>
      </div>
      <div>
        <h2>Gut zu wissen</h2>
        <p>«Tesla Approved Body Shop» steht auf der bisherigen Website des Betriebs bei seinen zertifizierten Partnern. Ersatzwagen: Tesla auf Anfrage.</p>
        <Luecke>Offene Frage: Den Eintrag in Teslas eigener Werkstattsuche bestätigt der Betrieb noch.</Luecke>
      </div>
    </div>
  </div>
</section>
<Faq fragen={faqTesla} titel="Fragen zum Tesla" />
<section class="abschluss">
  <h2>Ihren Tesla-Schaden melden?</h2>
  <div class="knoepfe"><a class="k k--blau" href="/schaden-melden/?fahrzeug=tesla" data-zaehl="anfrage-tesla" data-ort="tesla-ende">Tesla-Schaden melden</a></div>
</section>
</Klar>
