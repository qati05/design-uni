---
// Rahmen jeder Seite: Kopfdaten, Vorschau-Schalter, strukturierte Daten, Gerüst aus Kopf, Inhalt, Abschluss und Fuss.
// Titel, Beschreibung und h1 kommen aus texte.json (Schlüssel = Prop «seite»); bau/daten.mjs prüft sie beim Bau (text-uni S1, S3, S12).
// Im Gerüst darf die Beschreibung noch fehlen (HINWEIS); dann fehlt das Meta-Tag statt eines leeren.
// Slot «idee»: der grosse Satz aus der Idee steht über der h1 und ist keine Überschrift (zusammenspiel Entscheid 2).
// Vorschau: noindex, kein canonical. Livegang: canonical auf die eigene Adresse (text-uni S28).
import { betrieb as b, texte, bau, vorschau, seite as lies, pflege } from "../../bau/daten.mjs";
import Kopf from "../components/Kopf.astro";
import Fuss from "../components/Fuss.astro";
import Abschluss from "../components/Abschluss.astro";

const { seite, jsonld = false, abschluss = true, indexierbar = true, eigeneH1 = false } = Astro.props;
const s = lies(seite);
const canonical = !vorschau && indexierbar ? bau.adresse + Astro.url.pathname : null;
const robots = vorschau || !indexierbar ? "noindex" : null;

const pad = (z: string) => z.replace(".", ":").padStart(5, "0");
const offen = b.zeiten.filter((z: any) => z.fenster);
const ld: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": b.typ,
  name: b.name,
  address: { "@type": "PostalAddress", streetAddress: b.strasse, postalCode: b.plz, addressLocality: b.ort, ...(b.kanton ? { addressRegion: b.kanton } : {}), addressCountry: b.land },
  telephone: b.tel.e164,
  email: b.mail,
  ...(vorschau ? {} : { url: bau.adresse + "/" }),
  ...(b.geo ? { geo: { "@type": "GeoCoordinates", latitude: b.geo.lat, longitude: b.geo.lon } } : {}),
  openingHoursSpecification: offen.flatMap((z: any) => z.fenster.map(([von, bis]: string[]) => ({
    "@type": "OpeningHoursSpecification", dayOfWeek: z.ld.length === 1 ? z.ld[0] : z.ld, opens: pad(von), closes: pad(bis),
  }))),
};

// Eine Quelle für das Skript: Zeiten (Minuten seit Mitternacht, 0 = Sonntag) und Wortlaut des Status.
const tagNr: Record<string, number> = { Sunday: 0, Monday: 1, Tuesday: 2, Wednesday: 3, Thursday: 4, Friday: 5, Saturday: 6 };
const min = (z: string) => { const [h, m] = z.split("."); return parseInt(h) * 60 + parseInt(m); };
const zeiten: Record<number, number[][]> = {};
for (const z of offen) for (const t of z.ld) zeiten[tagNr[t]] = z.fenster.map(([v, e]: string[]) => [min(v), min(e)]);
// Ausnahmen (Feiertage, Betriebsferien) nach Datum: [] = geschlossen, sonst Fenster in Minuten.
const ausnahmen: Record<string, number[][]> = {};
for (const a of b.ausnahmen || []) ausnahmen[a.datum] = a.zu ? [] : a.fenster.map(([v, e]: string[]) => [min(v), min(e)]);
const daten = { zeiten, ausnahmen, status: texte.mikrotexte.status };
---
<!doctype html>
<html lang={bau.sprache} data-zaehl-endpunkt={process.env.ZAEHL_ENDPUNKT || bau.zaehlEndpunkt || undefined}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{s.titel}</title>
{s.beschreibung && <meta name="description" content={s.beschreibung}>}
{robots && <meta name="robots" content={robots}>}
{canonical && <link rel="canonical" href={canonical}>}
<link rel="preload" href="/fonts/barlow-semi-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/technik.css">
<link rel="stylesheet" href="/css/autospeedy.css">
{jsonld && <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)}></script>}
<script is:inline type="application/json" id="betrieb-daten" set:html={JSON.stringify(daten)}></script>
<script is:inline>try{document.documentElement.setAttribute("data-lack",matchMedia("(prefers-color-scheme: dark)").matches?"dunkel":"hell")}catch(e){}</script>
<script is:inline src="/js/main.js" defer></script>
<script is:inline src="/js/lack.js" defer></script>
<script is:inline src="/js/rueckruf.js" defer></script>
<script is:inline src="/js/zaehl.js" defer></script>
</head>
<body>
<a class="sprung" href="#inhalt">{texte.mikrotexte.sprunglink}</a>
{vorschau && <p data-vorschau>{texte.mikrotexte.vorschauHinweis}</p>}
{pflege?.hinweis?.aktiv && pflege.hinweis.text && <p class="saison"><a href={pflege.hinweis.link || "/schaden-melden/"} data-zaehl="saison" data-ort="band">{pflege.hinweis.text} <span aria-hidden="true">→</span></a></p>}
<Kopf aktiv={Astro.url.pathname} />
<main id="inhalt">
<slot name="idee" />
{s.h1 && !eigeneH1 && <h1>{s.h1}</h1>}
<slot />
{abschluss && <Abschluss />}
</main>
<Fuss />
</body>
</html>
