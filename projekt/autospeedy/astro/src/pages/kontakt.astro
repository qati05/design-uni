---
import Seite from "../layouts/Seite.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import Zeiten from "../components/Zeiten.astro";
import Tel from "../components/Tel.astro";
import Mail from "../components/Mail.astro";
import Route from "../components/Route.astro";
import Rueckruf from "../components/Rueckruf.astro";
import { betrieb as b } from "../../bau/daten.mjs";
---
<Seite seite="kontakt" jsonld eigeneH1>
<SeitenKopf seite="kontakt" idee="Alte Landstrasse 63." foto="fassade" alt="Gebäude der Auto Speedy AG mit Schild und Eingang «Büro – Empfang»">
  <p>{b.name}<br>{b.strasse}<br>{b.plz} {b.ort} {b.kanton}</p>
  <p>Telefon <Tel ort="kontakt" /><br>Mobil <a href={`tel:${b.mobil.e164}`} data-zaehl="anruf-mobil" data-ort="kontakt">{b.mobil.anzeige}</a><br><Mail ort="kontakt" /></p>
  <p><Route ort="kontakt" /></p>
</SeitenKopf>
<div class="seite">
  <Rueckruf ort="kontakt" titel="Lieber zurückgerufen werden?" text="Hinterlassen Sie Name und Telefon. Wir melden uns." anliegen={["Allgemein"]} />
  <h2>Öffnungszeiten</h2>
  <Zeiten />
  <p data-luecke>Lücke: Zu Samstag, Feiertagen, Betriebsferien und einem Notfalldienst fand das Studio keine Angabe des Betriebs.</p>
</div>
</Seite>
