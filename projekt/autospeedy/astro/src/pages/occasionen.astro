---
import Seite from "../layouts/Seite.astro";
import SeitenKopf from "../components/SeitenKopf.astro";
import FremdInhalt from "../components/FremdInhalt.astro";
import Rueckruf from "../components/Rueckruf.astro";
import { betrieb as b } from "../../bau/daten.mjs";
---
<Seite seite="occasionen" eigeneH1>
<SeitenKopf seite="occasionen" idee="Occasionen auf dem Areal." foto="fassade" alt="Gebäude der Auto Speedy AG, davor ein Defender und weitere Fahrzeuge">
  <p>Auf unserem Areal finden Sie laufend verschiedene Occasionen. Als markenunabhängige Garage kaufen wir auch Ihr Auto an.</p>
  </SeitenKopf>
<div class="seite seite--breit">
  <h2>Aktuelle Occasionen</h2>
  <FremdInhalt dienst="AutoScout24" titel="Occasionen anzeigen" text="Unsere Fahrzeuge erfassen wir auf AutoScout24. Hier sehen Sie die aktuelle Liste direkt auf unserer Seite." widget={b.occasionen?.widget} link={b.occasionen?.liste} linkText="Liste auf AutoScout24 öffnen" />
  <Rueckruf ort="occasionen" titel="Auto kaufen oder verkaufen?" text="Sagen Sie uns, worum es geht. Wir rufen Sie zurück." anliegen={["Occasion kaufen", "Mein Auto verkaufen"]} />
  <h2>Was wir anbieten</h2>
  <ul class="liste"><li>Verkauf von Occasionen</li><li>Autoankauf</li><li>technische Beratung</li><li>Abwicklung von Versicherungen</li></ul>
</div>
</Seite>
