---
// Startseite (Entwurf). Wortlaut nur aus fakten.md, nichts freigegeben.
import Seite from "../layouts/Seite.astro";
import Foto from "../components/Foto.astro";
import Zeiten from "../components/Zeiten.astro";
import Route from "../components/Route.astro";
import Tel from "../components/Tel.astro";
import Mail from "../components/Mail.astro";
import Schadenplan from "../components/Schadenplan.astro";
import stellenDaten from "../content/stellen.json";
import { betrieb as b, seite as lies } from "../../bau/daten.mjs";
const h1 = lies("index").h1;
const stellen = (stellenDaten as any).stellen;
---
<Seite seite="index" jsonld eigeneH1>
<div class="start">
  <div class="start__text">
    <p class="idee">Vom Kratzer bis zum Blechschaden.</p>
<svg class="schwung" viewBox="0 0 240 24" aria-hidden="true" focusable="false"><path d="M4 18 C 60 4, 150 2, 236 10" pathLength="1"/></svg>
    <h1>{h1}</h1>
    <ul class="fakten">
      <li><b aria-hidden="true">1</b><span>{b.strasse}, {b.plz} {b.ort}</span></li>
      <li><b aria-hidden="true">2</b><span>Mo bis Do 7.30 bis 12.00 und 13.15 bis 17.30 Uhr, Fr bis 17.15 Uhr</span></li>
      <li><b aria-hidden="true">3</b><span>Die Abwicklung mit Ihrer Versicherung übernehmen wir.</span></li>
    </ul>
    <a class="tesla-band" href="/tesla/" data-zaehl="tesla" data-ort="start"><span class="tesla-band__marke">Tesla Approved Body Shop</span><span>Sie fahren einen Tesla? Hier entlang</span></a>
  </div>
  <figure class="start__bild">
    <Foto name="defender-kabine" alt="Land Rover Defender in der hell beleuchteten Kabine der Werkstatt" sizes="(max-width: 860px) 100vw, 58vw" lcp />
  </figure>
</div>

<section class="band band--weiss planband" aria-labelledby="plan-titel">
  <div class="planband__text">
    <h2 id="plan-titel" class="band__titel">Wo hat es Ihr Auto erwischt?</h2>
    <p>Tippen Sie auf die Stelle. Wir öffnen die Schadenmeldung mit dieser Stelle schon ausgewählt.</p>
    <div class="planband__info" aria-live="polite" data-plan-info>
      <p class="planband__stelle" data-info-name>Stelle wählen</p>
      <p data-info-leistung>Vom Kratzer an der Stossstange bis zum Hagel auf dem Dach.</p>
      <a class="knopf" href="/schaden-melden/" data-info-link data-zaehl="anfrage" data-ort="schadenplan">Schaden melden</a>
    </div>
    <ul class="planband__liste">
      {stellen.map((s: any) => <li><a href={`/schaden-melden/?stelle=${s.id}`}>{s.name}</a></li>)}
    </ul>
  </div>
  <div class="planband__auto"><Schadenplan modus="links" titel="Auto von oben: Stelle des Schadens antippen" /></div>
</section>

<section class="band band--nacht" aria-labelledby="ablauf-titel">
  <h2 id="ablauf-titel" class="band__titel">So läuft eine Reparatur</h2>
  <ol class="ablauf">
    <li><span class="ablauf__nr">01</span><h3>Schaden melden</h3><p>Online mit dem Formular oder am Telefon unter <Tel ort="ablauf" />.</p></li>
    <li><span class="ablauf__nr">02</span><h3>Versicherung</h3><p>Die Schadenabwicklung mit Ihrer Versicherung erledigen wir für Sie.</p></li>
    <li><span class="ablauf__nr">03</span><h3>Reparatur</h3><p>Nach Herstellervorgaben und ausschliesslich mit Original-Ersatzteilen.</p></li>
  </ol>
  <p data-luecke>Lücke: Wie lange eine Reparatur dauert und ob es einen Ersatzwagen gibt, sagt der Betrieb noch.</p>
</section>

<section class="band band--silber" aria-labelledby="partner-titel">
  <h2 id="partner-titel" class="band__titel">Zertifizierte K + L Partner von</h2>
  <ul class="partner">
    <li><a href="/tesla/">Tesla <small>Approved Body Shop</small></a></li>
    <li>AMAG</li>
    <li>Land Rover</li>
    <li>Ayvens</li>
  </ul>
  <p class="quelle">Laut der bisherigen Website des Betriebs. Ausbildungsbetrieb und Mitglied von Carrosserie Suisse, Sektion Ostschweiz.</p>
</section>

<section class="band band--nacht" aria-labelledby="werkstatt-titel">
  <h2 id="werkstatt-titel" class="band__titel">Aus der Werkstatt</h2>
  <div class="galerie">
    <Foto name="maserati" alt="Mitarbeiter an einem blauen Maserati in der Halle, im Hintergrund das Auto-Speedy-Schild" sizes="(max-width: 860px) 100vw, 50vw" klasse="galerie__gross" />
    <Foto name="politur" alt="Mitarbeiterin poliert die Tür eines roten Ferrari" sizes="(max-width: 860px) 50vw, 25vw" />
    <Foto name="dellen-zug" alt="Mitarbeiter richtet eine Delle an einer weissen Motorhaube" sizes="(max-width: 860px) 50vw, 25vw" />
    <Foto name="transporter" alt="Weiss-roter Transporter mit offener Front in der Halle" sizes="(max-width: 860px) 50vw, 25vw" />
    <Foto name="felge-fertig" alt="Schwarze Alufelge mit glanzgedrehter Front" sizes="(max-width: 860px) 50vw, 25vw" />
  </div>
</section>

<section class="anfahrt" aria-labelledby="anfahrt-titel">
  <figure class="anfahrt__bild"><Foto name="fassade" alt="Gebäude der Auto Speedy AG mit Schild und Eingang «Büro – Empfang», davor ein Defender" sizes="(max-width: 860px) 100vw, 50vw" /></figure>
  <div class="anfahrt__text">
    <h2 id="anfahrt-titel" class="band__titel">So finden Sie uns</h2>
    <p>Etwas ausserhalb von Altstätten an der Alten Landstrasse 63.</p>
    <p>{b.name}<br>{b.strasse}<br>{b.plz} {b.ort}</p>
    <p><Tel ort="anfahrt" /><br><Mail ort="anfahrt" /></p>
    <Zeiten />
    <Route ort="anfahrt" />
  </div>
</section>
</Seite>
<script is:inline>
(function () {
  var info = document.querySelector("[data-plan-info]"); if (!info) return;
  var name = info.querySelector("[data-info-name]"), leis = info.querySelector("[data-info-leistung]"), link = info.querySelector("[data-info-link]");
  [].forEach.call(document.querySelectorAll('.plan--links .plan__stelle'), function (a) {
    function an() {
      [].forEach.call(document.querySelectorAll('.plan--links .plan__stelle'), function (x) { x.classList.remove("ist-aktiv"); });
      a.classList.add("ist-aktiv");
      name.textContent = a.dataset.name; leis.textContent = a.dataset.leistung;
      link.href = a.getAttribute("href"); link.textContent = a.dataset.name + ": Schaden melden";
    }
    a.addEventListener("mouseenter", an); a.addEventListener("focus", an);
  });
})();
</script>
