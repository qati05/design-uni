---
// Schadenmeldung (Hauptaktion). Kein Server-Endpunkt: Übergabe an das E-Mail-Programm, ehrliche Rückmeldung (zusammenspiel Teil 7).
import Seite from "../layouts/Seite.astro";
import Tel from "../components/Tel.astro";
import { betrieb as b, seite as lies } from "../../bau/daten.mjs";
const h1 = lies("schaden-melden").h1;
---
<Seite seite="schaden-melden" eigeneH1 abschluss={false}>
<div class="formularseite">
<div class="formularseite__kopf">
  <p class="idee idee--klein">Schaden passiert. Jetzt melden.</p>
<svg class="schwung" viewBox="0 0 240 24" aria-hidden="true" focusable="false"><path d="M4 18 C 60 4, 150 2, 236 10" pathLength="1"/></svg>
  <h1>{h1}</h1>
  <p>Beschreiben Sie kurz, was passiert ist. Die Abwicklung mit Ihrer Versicherung übernehmen wir.</p>
  <p class="formularseite__tel">Lieber sprechen? <Tel ort="schaden" /></p>
</div>
<form id="schaden-form" action={`mailto:${b.mail}?subject=Schadenmeldung`} method="post" enctype="text/plain" data-zaehl-start="schaden-start" data-zaehl-ende="schaden-ende">
  <p class="hilfe">Felder mit «(Pflicht)» brauchen wir, um Sie zu erreichen.</p>
  <fieldset>
    <legend>1 · Ihr Fahrzeug (Pflicht)</legend>
    <div class="wahl">
      <label><input type="radio" name="Fahrzeug" value="Tesla" required> Tesla</label>
      <label><input type="radio" name="Fahrzeug" value="Andere Marke" required> Andere Marke</label>
    </div>
  </fieldset>
  <fieldset>
    <legend>2 · Art des Schadens (freiwillig)</legend>
    <div class="wahl">
      <label><input type="radio" name="Schadenart" value="Unfall oder Blechschaden"> Unfall, Blech</label>
      <label><input type="radio" name="Schadenart" value="Hagel oder Delle"> Hagel, Delle</label>
      <label><input type="radio" name="Schadenart" value="Kratzer oder Lack"> Kratzer, Lack</label>
      <label><input type="radio" name="Schadenart" value="Scheibe"> Scheibe</label>
      <label><input type="radio" name="Schadenart" value="Felge"> Felge</label>
    </div>
  </fieldset>
  <div><label for="f-schaden">3 · Was ist passiert? (Pflicht)</label><textarea id="f-schaden" name="Beschreibung" required></textarea><p class="hilfe">Zum Beispiel: Parkschaden hinten links, Stossstange eingedrückt.</p></div>
  <div><label for="f-name">4 · Name (Pflicht)</label><input id="f-name" name="Name" type="text" autocomplete="name" required></div>
  <div><label for="f-tel">5 · Telefon (Pflicht)</label><input id="f-tel" name="Telefon" type="tel" autocomplete="tel" required><p class="hilfe">Damit wir Sie für Rückfragen erreichen.</p></div>
  <button class="knopf knopf--gross" type="submit">Meldung im E-Mail-Programm öffnen</button>
  <p class="hilfe">Verantwortlich: {b.name}. Ihre Angaben dienen nur der Bearbeitung Ihrer Meldung. Fotos vom Schaden hängen Sie in Ihrem E-Mail-Programm an. Gesendet ist die Meldung erst, wenn Sie dort auf Senden tippen.</p>
  <p data-rueckmeldung hidden role="status"></p>
</form>
</div>
</Seite>
<script is:inline>
(function () {
  var f = document.getElementById("schaden-form"); if (!f) return;
  if (new URLSearchParams(location.search).get("fahrzeug") === "tesla") { var r = f.querySelector('input[value="Tesla"]'); if (r) r.checked = true; }
  f.addEventListener("submit", function () {
    var r = f.querySelector("[data-rueckmeldung]"); r.hidden = false;
    r.textContent = "Ihr E-Mail-Programm öffnet sich mit Ihrer Meldung. Gesendet ist sie erst, wenn Sie dort auf Senden tippen. Öffnet sich nichts, rufen Sie uns an: 071 755 88 61.";
  });
})();
</script>
