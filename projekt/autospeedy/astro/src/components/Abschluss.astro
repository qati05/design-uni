---
// Abschluss am Seitenende: Schaden melden und Telefon (zusammenspiel Entscheid 6).
import { texte as t } from "../../bau/daten.mjs";
import Hauptaktion from "./Hauptaktion.astro";
import Tel from "./Tel.astro";
---
<section class="abschluss" aria-labelledby="abschluss-titel">
<div>
<h2 id="abschluss-titel">{t.mikrotexte.abschluss.titel}</h2>
<p>{t.mikrotexte.abschluss.text}</p>
</div>
<div class="abschluss__aktionen"><Hauptaktion ort="abschluss" /><Tel ort="abschluss" /></div>
</section>
