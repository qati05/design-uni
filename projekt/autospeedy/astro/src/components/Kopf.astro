---
// Kopf: Name, Kontakt-Link, Telefon und Hauptaktion (Schaden melden) auf jeder Seite (Wunsch des Betriebs).
// Am Handy wandern Telefon und Hauptaktion in eine Leiste unten (public/css/autospeedy.css).
import { betrieb as b, texte as t } from "../../bau/daten.mjs";
import Hauptaktion from "./Hauptaktion.astro";
import Tel from "./Tel.astro";
const { aktiv = "" } = Astro.props;
const cur = (p: string) => (aktiv === p ? "page" : undefined);
---
<header>
<a href="/" aria-label={`${b.name}, ${t.mikrotexte.startseite}`}>{b.name}</a>
<nav aria-label={t.mikrotexte.navName}>{t.navigation.map((n: any) => <a href={n.pfad} aria-current={cur(n.pfad)}>{n.text}</a>)}</nav>
<div class="aktionen"><Tel ort="kopf" /><Hauptaktion ort="kopf" /></div>
</header>
