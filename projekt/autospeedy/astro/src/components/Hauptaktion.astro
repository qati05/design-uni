---
// Hauptaktion als Link: Schaden melden. Text und Ziel aus texte.json; data-zaehl und data-ort sind Zählpunkte.
import { texte as t } from "../../bau/daten.mjs";
const { ort } = Astro.props;
---
<a class="knopf" href={t.hauptaktion.ziel} data-zaehl="anfrage" data-ort={ort}>{t.hauptaktion.text}</a>
