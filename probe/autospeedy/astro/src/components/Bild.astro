---
// Foto mit Abdeckkante. Pflicht: alt, breite, hoehe. lazy=false nur für das erste grosse Bild (fetch=true).
const { datei, alt, caption, klasse = "", kante = true, zug = false, breite, hoehe, lazy = true, fetch = false } = Astro.props;
---
<figure class={`bild ${klasse}`}>{kante && <div class={`kante-bar${zug ? " kante-zug" : ""}`}></div>}<img src={`bilder/${datei}`} alt={alt} width={breite} height={hoehe} loading={lazy ? "lazy" : undefined} fetchpriority={fetch ? "high" : undefined} decoding="async">{caption && <figcaption>{caption}</figcaption>}</figure>
