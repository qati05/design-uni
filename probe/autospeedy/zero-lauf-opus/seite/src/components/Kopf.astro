---
// Kopf, klebt oben: Marke, Wörter als Menü (Desktop), Telefon, «Schaden melden» eingekreist, Menü am Handy.
import b from "../content/betrieb.json";
import Tel from "./Tel.astro";
import Route from "./Route.astro";
import Hauptaktion from "./Hauptaktion.astro";
const { aktiv = "" } = Astro.props;
const cur = (h: string) => (aktiv === h ? "page" : undefined);
---
<header class="kopf">
<div class="rahmen kopf-innen">
<a class="marke" href="index.html"><img src="bilder/logo-180.png" srcset="bilder/logo-180.png 1x, bilder/logo-360.png 2x" width="180" height="65" alt={`${b.name}, zur Startseite`}></a>
<nav class="nav-wort" aria-label="Hauptmenü"><ul>{b.nav.map(([h, t]) => <li><a href={h} aria-current={cur(h)}>{t}</a></li>)}</ul></nav>
<div class="kopf-aktionen">
<Tel ort="kopf" kopf />
<Hauptaktion ort="kopf" klasse="kopf-aktion" />
<details class="menue"><summary><span class="menue-zeichen" aria-hidden="true"></span>Menü</summary>
<nav class="menue-liste" aria-label="Menü am Handy"><ul>
<li><a href="index.html" aria-current={cur("index.html")}>Start</a></li>
<li><a href="schaden.html" aria-current={cur("schaden.html")}>Schaden melden</a></li>
{b.nav.map(([h, t]) => <li><a href={h} aria-current={cur(h)}>{t}</a></li>)}
<li class="menue-fakt"><Route ort="menue" text={`Route: ${b.strasse}, ${b.ort}`} /></li>
<li class="menue-fakt"><Tel ort="menue" /></li>
</ul></nav></details>
</div>
</div>
</header>
