---
// Telefon als Link. nummer 1 = Festnetz, 2 = Mobil. kopf = Kurzform mit Symbol für die Kopfzeile.
import b from "../content/betrieb.json";
const { ort, nummer = 1, kopf = false, klasse = "" } = Astro.props;
const t = nummer === 2 ? b.tel2 : b.tel1;
---
{kopf
  ? <a class={`kopf-tel ${klasse}`.trim()} href={t.href} data-zaehl="anruf" data-ort={ort}><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z"/></svg><span class="sr">Anrufen: </span><span class="tel-zahl">{t.zeige}</span></a>
  : <a class={`tel ${klasse}`.trim()} href={t.href} data-zaehl="anruf" data-ort={ort}><span class="nowrap">{t.zeige}</span></a>}
