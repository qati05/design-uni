{
  "$description": "Auto Speedy AG, Vorschau. W3C Design Tokens (Format 2025.10). Namen aus dem Betrieb; geteilt zwischen Projekten sind nur fokus, abstand, fehler. Erzeugt public/css/tokens.css (werkzeug/tokens.mjs).",
  "farbe": {
    "$type": "color",
    "kabinenweiss": { "$value": { "colorSpace": "srgb", "components": [0.957, 0.965, 0.973], "hex": "#f4f6f8" }, "$description": "Grund; kühle Wand der Lackierkabine (foto-13, 18)" },
    "abdeckweiss": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }, "$description": "Felder und Bewertungskarten" },
    "logo-schwarz": { "$value": { "colorSpace": "srgb", "components": [0.067, 0.075, 0.09], "hex": "#111317" }, "$description": "Text; Schrift des Logos (Pipette #050505, leicht aufgehellt)" },
    "logo-navy": { "$value": { "colorSpace": "srgb", "components": [0.145, 0.192, 0.271], "hex": "#253145" }, "$description": "S-Bogen des Logos (Pipette); Zweiton der Fotos, Fussfläche" },
    "logo-silber": { "$value": { "colorSpace": "srgb", "components": [0.741, 0.745, 0.753], "hex": "#bdbec0" }, "$description": "Schatten des Logos; Haarlinien (Schmuck, nicht Feldrand)" },
    "graphit": { "$value": { "colorSpace": "srgb", "components": [0.333, 0.357, 0.4], "hex": "#555b66" }, "$description": "Nebentext und Feldränder (≥ 4,5:1 auf Kabinenweiss)" },
    "marker": { "$value": { "colorSpace": "srgb", "components": [0.027, 0.216, 0.773], "hex": "#0737c5" }, "$description": "Markerkreis auf foto-06; nur Kreis und Hauptaktion" },
    "marker-hell": { "$value": { "colorSpace": "srgb", "components": [0.62, 0.71, 1], "hex": "#9eb5ff" }, "$description": "Kreis und Links auf der Navy-Fläche" },
    "fehler": { "$value": { "colorSpace": "srgb", "components": [0.7, 0.11, 0.11], "hex": "#b31c1c" }, "$description": "funktional, geteilt" },
    "fokus": { "$value": { "colorSpace": "srgb", "components": [0.027, 0.216, 0.773], "hex": "#0737c5" }, "$description": "funktional, geteilt; Fokusrahmen 3 px" }
  },
  "schrift": {
    "$type": "fontFamily",
    "logo-grotesk": { "$value": ["Mona Sans", "Arial Narrow", "Arial", "sans-serif"], "$description": "Titel schräg und schmal wie die Wortmarke; Text aufrecht" }
  },
  "groesse": {
    "$type": "dimension",
    "text": { "$value": { "value": 18, "unit": "px" } },
    "klein": { "$value": { "value": 15, "unit": "px" } },
    "zwischen": { "$value": { "value": 24, "unit": "px" } }
  },
  "abstand": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 16, "unit": "px" } },
    "4": { "$value": { "value": 24, "unit": "px" } },
    "5": { "$value": { "value": 40, "unit": "px" } },
    "6": { "$value": { "value": 64, "unit": "px" } },
    "7": { "$value": { "value": 104, "unit": "px" } },
    "8": { "$value": { "value": 168, "unit": "px" } }
  },
  "dauer": {
    "$type": "duration",
    "markieren": { "$value": { "value": 250, "unit": "ms" }, "$description": "Kreis um eine gewählte Auswahl (Rückmeldung)" },
    "einkreisen": { "$value": { "value": 700, "unit": "ms" }, "$description": "die eine Bewegung: Kreis um «Schaden» auf der Startseite" }
  },
  "kurve": {
    "$type": "cubicBezier",
    "filzstift": { "$value": [0.05, 0.7, 0.1, 1], "$description": "starke Abbremsung wie ein Strich, der ausläuft" }
  }
}
