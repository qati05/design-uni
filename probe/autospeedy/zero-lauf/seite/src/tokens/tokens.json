{
  "$description": "Tokens Auto Speedy AG. W3C Design Tokens, Format 2025.10. Namen aus dem Betrieb. Eine Quelle: scripts/tokens.mjs erzeugt daraus public/css/tokens.css.",
  "farbe": {
    "$type": "color",
    "kabine": { "$description": "Seitengrund: kühles Hell der Lackierkabine (Wände auf foto-13 bis 16). Kein Creme.", "$value": { "colorSpace": "srgb", "components": [0.910, 0.929, 0.953], "hex": "#e8edf3" } },
    "kabinenlicht": { "$description": "Flächen und Karten: das Licht der Leisten in der Kabine.", "$value": { "colorSpace": "srgb", "components": [0.961, 0.969, 0.980], "hex": "#f5f7fa" } },
    "tinte": { "$description": "Text: das Schwarz der äusseren Schwünge im Logo, blau getönt.", "$value": { "colorSpace": "srgb", "components": [0.059, 0.075, 0.106], "hex": "#0f131b" } },
    "leise": { "$description": "Zweittext, 6,4:1 auf kabine.", "$value": { "colorSpace": "srgb", "components": [0.275, 0.314, 0.373], "hex": "#46505f" } },
    "marine": { "$description": "Das Marineblau des inneren Schwungs im Logo (Pipette am Raster: ca. #283a50). Einziger Akzent: Hauptaktion und Kreis.", "$value": { "colorSpace": "srgb", "components": [0.149, 0.216, 0.306], "hex": "#26374e" } },
    "marine-tief": { "$description": "Marine gedrückt.", "$value": { "colorSpace": "srgb", "components": [0.094, 0.149, 0.220], "hex": "#182638" } },
    "schwung-grau": { "$description": "Das Grau des Schattens im Logo; nur für Zierflächen, nie für Text.", "$value": { "colorSpace": "srgb", "components": [0.722, 0.722, 0.753], "hex": "#b8b8c0" } },
    "fuge": { "$description": "Haarlinie zwischen Abschnitten (keine Bedienkante).", "$value": { "colorSpace": "srgb", "components": [0.757, 0.788, 0.831], "hex": "#c1c9d4" } },
    "feldrand": { "$description": "Feldrand und Auswahl-Ring, 4,1:1 auf kabinenlicht.", "$value": { "colorSpace": "srgb", "components": [0.420, 0.463, 0.525], "hex": "#6b7686" } },
    "boden-blau": { "$description": "Aufgehelltes Blau der Bodenplatten (foto-13): Grund der gewählten Auswahl.", "$value": { "colorSpace": "srgb", "components": [0.780, 0.827, 0.902], "hex": "#c7d3e6" } },
    "fehler": { "$description": "Fehlertext, mit Zeichen und Satz, nie Farbe allein.", "$value": { "colorSpace": "srgb", "components": [0.639, 0.149, 0.110], "hex": "#a3261c" } }
  },
  "schrift": {
    "titel": { "$type": "fontFamily", "$value": ["Barlow Condensed", "Arial Narrow", "sans-serif"] },
    "text": { "$type": "fontFamily", "$value": ["Barlow", "Arial", "sans-serif"] },
    "klein": { "$type": "dimension", "$value": { "value": 0.9375, "unit": "rem" } },
    "fliess": { "$type": "dimension", "$value": { "value": 1.125, "unit": "rem" } },
    "lead": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
    "h3": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
    "h2": { "$type": "string", "$value": "clamp(2.5rem, 5.2vw, 4.5rem)" },
    "titel-gross": { "$type": "string", "$value": "clamp(3.9rem, 10.4vw, 9.6rem)" }
  },
  "abstand": {
    "$type": "dimension",
    "a1": { "$value": { "value": 0.25, "unit": "rem" } },
    "a2": { "$value": { "value": 0.5, "unit": "rem" } },
    "a3": { "$value": { "value": 0.75, "unit": "rem" } },
    "a4": { "$value": { "value": 1, "unit": "rem" } },
    "a5": { "$value": { "value": 1.5, "unit": "rem" } },
    "a6": { "$value": { "value": 2, "unit": "rem" } },
    "a7": { "$value": { "value": 3, "unit": "rem" } },
    "a8": { "$value": { "value": 4.5, "unit": "rem" } },
    "a9": { "$value": { "value": 7, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "feld": { "$value": { "value": 6, "unit": "px" } },
    "kreis": { "$value": { "value": 999, "unit": "px" } }
  },
  "bewegung": {
    "schnell": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
    "rueckmeldung": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "kreis-zeichnen": { "$description": "Die eine Bewegung: der Kreis um «Schaden».", "$type": "duration", "$value": { "value": 900, "unit": "ms" } },
    "aus": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "funktional": {
    "fokus-breite": { "$description": "Geteilt zwischen Projekten (funktional).", "$type": "dimension", "$value": { "value": 3, "unit": "px" } },
    "tippziel": { "$description": "Geteilt zwischen Projekten (funktional).", "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
  }
}
