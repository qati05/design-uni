{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "farbe": {
    "$type": "color",
    "fueller": { "$value": "#CDD3D6", "$description": "Füllergrau: Grund der Seite, Farbe eines Teils vor dem Lack" },
    "blech": { "$value": "#EEF1F1", "$description": "Kabinenweiss: Flächen zum Lesen, Felder" },
    "tusche": { "$value": "#0E1620", "$description": "Tiefblau der Arbeitsshirts: Schrift, Striche der Skizze" },
    "tusche-weich": { "$value": "#3A4652", "$description": "Nebentext" },
    "marker": { "$value": "#A51C16", "$description": "Markerrot: Markierungen und Hauptaktion; einzige Buntfarbe" },
    "raster": { "$value": "#0E162017", "$description": "Millimeterraster" }
  },
  "schrift": {
    "$type": "fontFamily",
    "beschriftung": { "$value": ["Saira Condensed", "Arial Narrow", "sans-serif"] },
    "text": { "$value": ["Barlow", "Arial", "sans-serif"] }
  },
  "funktion": {
    "fokus": { "$type": "color", "$value": "#0E1620" },
    "fehler": { "$type": "color", "$value": "#A51C16" },
    "raster-schritt": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
  }
}
